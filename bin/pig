#!/usr/bin/env php
<?php

declare(strict_types=1);

/**
 * pig — a coding agent in a terminal.
 *
 *   ANTHROPIC_API_KEY=sk-ant-... bin/pig
 *   bin/pig --read-only --model sonnet:high --theme light
 *
 * Read-write by default, unlike `examples/agent.php`: this one has someone watching it,
 * and every edit shows up as a diff before the next thing happens.
 */

foreach ([__DIR__ . '/../vendor/autoload.php', __DIR__ . '/../../../autoload.php'] as $autoload) {
    if (is_file($autoload)) {
        require $autoload;

        break;
    }
}

use Pig\Ai\Http\HttpClient;
use Pig\Ai\Http\HttpError;
use Pig\Ai\Http\Proxy;
use Pig\Async\Async;
use Pig\CodingAgent\Export\HtmlExport;
use Pig\CodingAgent\Cli\Arguments;
use Pig\CodingAgent\Cli\UpdateCheck;
use Pig\CodingAgent\Cli\FileArguments;
use Pig\CodingAgent\Cli\ModelList;
use Pig\CodingAgent\Auth;
use Pig\CodingAgent\Changelog;
use Pig\CodingAgent\Cli\SessionPicker;
use Pig\CodingAgent\CodingAgent;
use Pig\CodingAgent\CodingAgentError;
use Pig\CodingAgent\Antigravity\Catalog as AntigravityCatalog;
use Pig\CodingAgent\CustomModels;
use Pig\CodingAgent\Interactive\InteractiveMode;
use Pig\CodingAgent\Rpc\RpcMode;
use Pig\CodingAgent\Migrations;
use Pig\CodingAgent\PrintMode;
use Pig\CodingAgent\Session\SessionManager;
use Pig\CodingAgent\Settings;
use Pig\CodingAgent\Theme\Palette;
use Pig\CodingAgent\Tools\ToolSet;
use Pig\CodingAgent\Timings;
use Pig\CodingAgent\Version;
use Pig\Tui\Style;

// **Asked of Composer rather than written here.** Packagist derives a package's version from its
// **tag**, and the update check below compares against Packagist — so a number written down
// anywhere in this repository is a copy that can disagree with the tag, and the way it disagrees is
// the worst one available: a build installed from tag 0.2.0 that still says 0.1.0 reports itself as
// out of date for ever. `Version` reads Composer's own answer, so there is nothing to bump.
define('VERSION', Version::current());

// The first mark is an anchor and costs nothing; every one after it is the gap since the
// last. All of them are no-ops unless `PIG_TIMING=1`, which is why they can sit in the flow
// rather than behind an `if` at each step.
Timings::mark('start');

$arguments = Arguments::parse(array_slice($argv, 1));
$options = $arguments->options;
Timings::mark('parseArgs');

if (isset($options['version'])) {
    echo 'pig ' . VERSION . "\n";

    exit(0);
}

if (isset($options['help'])) {
    echo <<<TEXT
    pig — a coding agent in a terminal.

      --model <id>      which model to talk to (default: claude-sonnet-4-5).
                        A part of the name will do: `sonnet`, `haiku`, `opus 4.1`.
                        Add a thinking level with a colon: `sonnet:high`.
      --models <list>   narrow this session to these models, comma-separated: the first
                        is what it opens on, and ctrl+p cycles within them. A pattern
                        may be a glob and may carry a level: `sonnet:high,'anthropic/*'`
      --list-models [s] list the models there is a key for, and stop. With a search
                        it is fuzzy over provider and id: `--list-models gem pro`
      --api-key <key>   use this key for the model's provider, this run only.
                        Not saved; beats the environment and any stored sign-in.
      --proxy <url>     reach providers through this proxy, this run only:
                        `http://127.0.0.1:7890` or `socks5://127.0.0.1:7891`.
                        Otherwise `https_proxy`/`all_proxy`, then `proxy.url` in
                        the settings. `no_proxy` and `proxy.bypass` list the hosts
                        to reach directly; loopback always is.
      --no-proxy        ignore all of that and connect directly
      -v, --version     print the version, and stop
      -h, --help        this
      --theme <name>    dark or light (default: dark)
      --thinking <l>    off, minimal, low, medium, high, xhigh
      --tools <list>    which built-in tools the model gets, comma-separated
                        (default: read,bash,edit,write; also grep, find, ls)
      --read-only       no edit, write or bash
      --cwd <path>      where to work (default: here)
      -c, --continue    pick up the most recent session here
      -r, --resume      choose from a list; `--resume <file>` opens one by path
      --session <id>    resume a session by its ID or path
      --no-save         do not write this session to disk
      --export <file>   write a session file out as HTML and stop. A second word is
                        where it goes: `--export a.jsonl out.html`
      --skills-dir <d>  one more folder of skills, on top of the standard ones
      --no-skills       start without loading any skills, wherever they live
      --no-hooks        start without loading ~/.pig/agent/hooks or .pig/hooks
      --no-tools        start without loading ~/.pig/agent/tools or .pig/tools
      --extension <p>   load an explicit extension file or directory
      --no-extensions   start without loading extensions
      --no-update-check do not ask Packagist whether there is a newer pig
      -p, --print       say it, print the answer, exit — the same as --mode text
      --mode <m>        text, json or rpc. Any of them leaves the terminal behind:
                        text prints the last answer, json prints every event as it
                        happens, rpc reads commands as JSON lines on stdin.

    Anything that is not an option is a message, and `@some/file` is read in front of
    the first one — an image goes in as an image. `--` ends the options, for a message
    that starts with a dash.

      bin/pig "what does bin/pig do?"          ask, then carry on in the terminal
      bin/pig -p @src/Thing.php "why so slow?"  ask, print, exit
      bin/pig --mode json -p "..." | jq        every event, as it happens

    TEXT;

    exit(0);
}

$cwd = $options['cwd'] ?? (getcwd() ?: '.');

if (!is_dir($cwd)) {
    fwrite(STDERR, Style::red("No such directory: {$cwd}\n"));

    exit(1);
}

// Which way in. Upstream's rule, kept: `--mode` given at all means no terminal, and `-p` is
// the short way of saying `--mode text`. So the terminal is the default and nothing but the
// absence of both selects it.
$mode = $arguments->mode();

if (!$arguments->isKnownMode()) {
    fwrite(STDERR, Style::red("No mode called '{$mode}'. There is " . implode(', ', Arguments::MODES) . ".\n"));

    exit(1);
}

$interactive = $arguments->isInteractive();
$messages = $arguments->messages;
$fileArgs = $arguments->files;

// Refused rather than ignored, as upstream refuses it: in rpc mode the conversation arrives
// as commands, so a file read here would be prepended to a prompt that never comes.
if ($mode === 'rpc' && ($fileArgs !== [] || $messages !== [])) {
    fwrite(STDERR, Style::red("--mode rpc takes its messages as commands, not as arguments.\n"));

    exit(1);
}

// `needsAMessage()` rather than `!$interactive`, and the difference is rpc mode: its conversation
// arrives as commands on standard input, so it needs no message — and demanding one here, while the
// guard above refuses one, made `--mode rpc` impossible to start by either route.
if ($arguments->needsAMessage() && $messages === [] && $fileArgs === []) {
    fwrite(STDERR, Style::red("Nothing to say. Pass a message, or leave off --mode for the terminal.\n"));

    exit(1);
}

// The order everywhere below: what was typed, then the environment, then what was chosen
// last time, then the built-in default.
$settings = isset($options['no-save']) ? Settings::inMemory() : Settings::load($cwd);

foreach ($settings->problems() as $problem) {
    fwrite(STDERR, Style::yellow("settings: {$problem}\n"));
}

Timings::mark('settings');

// Before anything opens a socket, which the first token refresh in `Auth::discover()` already
// does. `--proxy`, then the environment, then the settings file — the order stated above.
if (isset($options['no-proxy'])) {
    HttpClient::useProxy(null);
} else {
    try {
        $proxy = isset($options['proxy']) && $options['proxy'] !== ''
            ? Proxy::parse($options['proxy'], $settings->proxyBypass())
            : Proxy::fromEnvironment(getenv())?->bypassing($settings->proxyBypass());

        if ($proxy === null && $settings->proxyUrl() !== null) {
            $proxy = Proxy::parse($settings->proxyUrl(), $settings->proxyBypass());
        }

        HttpClient::useProxy($proxy);
    } catch (HttpError $error) {
        // Named and fatal rather than falling back to a direct connection: in the network a proxy
        // is for, "direct" is not a worse route, it is no route, and a run that quietly tried it
        // would report the provider as unreachable and send somebody looking at the wrong thing.
        fwrite(STDERR, Style::red('proxy: ' . $error->getMessage() . "\n"));

        exit(1);
    }
}

Timings::mark('proxy');

// Before `Auth::discover()`, because that is what these are for: a pi install left mid-upgrade
// keeps its credentials in an `oauth.json` nothing here reads, and its conversations in files
// `--resume` cannot see. Not affected by `--no-save` for the same reason `Auth` is not — the flag
// is about not writing *this conversation* down.
$movedCredentials = Migrations::run();

if ($movedCredentials !== []) {
    // Upstream's line, word for word — `main.ts` shows it as a warning and this is where pig puts
    // the warnings that happen before the UI exists, beside the settings and credential ones.
    // Said at all because pig has just written in pi's directory, which is not something to do
    // quietly; one line rather than one per provider, because it is one thing that happened.
    fwrite(STDERR, Style::yellow(
        'Migrated credentials to auth.json: ' . implode(', ', $movedCredentials) . "\n",
    ));
}

Timings::mark('migrations');

// Not affected by `--no-save`, which is about not writing this conversation down. A stored
// sign-in is still the way in, and a token renewed during the run has to be kept or the next
// run starts by renewing a token that was already replaced.
$auth = Auth::discover(settings: $settings);

foreach ($auth->problems() as $problem) {
    fwrite(STDERR, Style::yellow("credentials: {$problem}\n"));
}

Timings::mark('credentials');

// Before the model is resolved, because `--model my-box/qwen3-coder` has to be able to find
// one of these. `--no-save` gets none of it: that flag means this run touches nothing of the
// person's, and a declared provider is one more thing read off their disk.
$custom = isset($options['no-save']) ? CustomModels::none() : CustomModels::discover();
$custom->install($auth);

foreach ($custom->problems as $problem) {
    // Named and carried on, like a settings file that is not JSON: the built-in models are
    // still there and the session still starts. A bad line loses only itself.
    fwrite(STDERR, Style::yellow("models.json: {$problem}\n"));
}

// After the declared providers and before the model is resolved, for the same reasons. The
// catalogue the `pi-antigravity` extension keeps refreshed on disk is a newer reading of the
// endpoint `Ai\Models::ANTIGRAVITY_MODELS` was printed from — same authority, so it wins; see
// `Antigravity\Catalog`. `--no-save` reads none of it, as it reads no `models.json`: that flag
// means this run touches nothing of the person's.
$catalogue = isset($options['no-save']) ? AntigravityCatalog::none() : AntigravityCatalog::discover();
$catalogue->install();

foreach ($catalogue->problems as $problem) {
    fwrite(STDERR, Style::yellow("antigravity: {$problem}\n"));
}

Timings::mark('customModels');

// After the declared providers, not before: a listing that cannot show the model somebody
// just added to `models.json` is a listing they will not trust about the rest either. It
// costs a settings read and a file read to get here, which nobody notices on a command that
// prints and exits.
//
// `--list-models` is upstream's name for it, and pig's `--models` used to be. They had to swap:
// upstream's `--models` takes patterns and *scopes* the session, so the same word meant two
// different things in the two tools — one of which prints and exits.
if (isset($options['list-models'])) {
    echo ModelList::render($options['list-models'], $auth), "\n";

    exit(0);
}

// Prints and exits, like `--list-models`, and for the same reason it sits this far down: the theme
// decides what the page looks like, and the theme comes from the settings. A session on disk and
// no wish to reopen it had no way out until this — `/export` needs a running session and the RPC
// `export` command needs a host.
if (isset($options['export'])) {
    try {
        // The write first and the sentence after, not `echo 'Exported to: ', …` with the call as
        // the second argument: `echo` writes left to right, so a failure printed the prefix and
        // then the error under it. Found by running it, which is the only way that shows.
        $written = HtmlExport::fromFile(
            $options['export'],
            $arguments->messages[0] ?? null,
            $cwd,
            $options['theme'] ?? ($settings->theme() ?? 'dark'),
        );

        echo "Exported to: {$written}\n";
    } catch (Throwable $problem) {
        fwrite(STDERR, Style::red($problem->getMessage() . "\n"));

        exit(1);
    }

    exit(0);
}

$theme = $options['theme'] ?? (getenv('PIG_THEME') ?: ($settings->theme() ?? 'dark'));

if (!in_array($theme, Palette::names(), true)) {
    fwrite(STDERR, Style::red("No theme called '{$theme}'. There is " . implode(' and ', Palette::names()) . ".\n"));

    exit(1);
}

// Which built-in tools the model gets. Checked here rather than inside the assembly for the same
// reason the theme is: a name that matches nothing should be one line on the shell, before anything
// has been loaded, and it should list what the names are.
// Split here rather than in `session()`, which is the same division `--tools` follows: the flag's
// spelling is the command line's business and what it resolves to is the library's.
$modelPatterns = isset($options['models'])
    ? array_values(array_filter(array_map('trim', explode(',', $options['models']))))
    : null;

if ($modelPatterns === []) {
    fwrite(STDERR, Style::red("--models needs at least one model or pattern after it.\n"));

    exit(1);
}

$toolNames = null;

if (isset($options['tools'])) {
    $toolNames = array_values(array_filter(array_map('trim', explode(',', strtolower($options['tools'])))));
    $unknown = array_values(array_diff($toolNames, ToolSet::ALL));

    if ($toolNames === []) {
        fwrite(STDERR, Style::red('--tools needs at least one name: ' . implode(', ', ToolSet::ALL) . ".\n"));

        exit(1);
    }

    if ($unknown !== []) {
        fwrite(STDERR, Style::red(
            'No tool called ' . implode(' or ', array_map(static fn (string $one): string => "'{$one}'", $unknown))
                . '. There is ' . implode(', ', ToolSet::ALL) . ".\n",
        ));

        exit(1);
    }
}

// Resolved here rather than inside the assembly, because choosing one draws a list on the
// terminal and `CodingAgent::session()` has no screen: it takes a path, or nothing.
$resumePath = $options['session'] ?? $options['resume'] ?? null;

if (isset($options['session'])) {
    $sessionArg = $options['session'];

    if ($sessionArg === '') {
        fwrite(STDERR, Style::red("--session requires a session ID or path.\n"));

        exit(1);
    }

    $resolved = SessionManager::find($cwd, $sessionArg);

    if ($resolved === null) {
        fwrite(STDERR, Style::red("No session found matching '{$sessionArg}'.\n"));

        exit(1);
    }

    $resumePath = $resolved;
} elseif ($resumePath !== null && $resumePath !== '') {
    $resolved = SessionManager::find($cwd, $resumePath);

    if ($resolved !== null) {
        $resumePath = $resolved;
    }
}

if ($resumePath === '' && !isset($options['no-save'])) {
    // `--resume` with nothing after it means "show me the list": a session file is named after six
    // random bytes under a flattened project path, so a flag that demands the path is a flag nobody
    // can use from memory. Only with a terminal to draw it on — in `--mode text|json|rpc` there is
    // nobody to ask, so it stays the error it was.
    if (!$interactive) {
        fwrite(STDERR, Style::red("--resume needs the path to a session file.\n"));

        exit(1);
    }

    $sessions = SessionManager::listFor($cwd);

    if ($sessions === []) {
        fwrite(STDERR, Style::yellow("No earlier sessions in {$cwd}. Starting a new one.\n"));
    }

    // Escape answers null, which starts a new session — someone who opened the list and changed
    // their mind still wanted pig, and refusing to start would only make them type the command
    // again. Ctrl+C is the other thing, and it is the caller's to do: the list has already put
    // the terminal back, so this is an ordinary end to the program and not a signal.
    $choice = SessionPicker::ask($sessions, Palette::named($theme));

    if ($choice->quit) {
        exit(0);
    }

    $resumePath = $choice->path;
}

// Everything from the model to the restored conversation. It lives in `CodingAgent::session()`
// rather than here for the reason `Cli\Arguments` and `Cli\SignIn` are classes: a script ending in
// `exit()` cannot be called twice, so two hundred lines of resolution order had no test.
try {
    $started = CodingAgent::session(
        $cwd,
        $settings,
        $auth,
        environment: getenv(),
        model: $options['model'] ?? null,
        thinking: $options['thinking'] ?? null,
        apiKey: $options['api-key'] ?? null,
        resume: $resumePath === '' ? null : $resumePath,
        continue: isset($options['continue']),
        save: !isset($options['no-save']),
        readOnly: isset($options['read-only']),
        withHooks: !isset($options['no-hooks']),
        withSkills: !isset($options['no-skills']),
        withTools: !isset($options['no-tools']),
        withExtensions: !isset($options['no-extensions']),
        skillsDir: $options['skills-dir'] ?? null,
        tools: $toolNames,
        models: $modelPatterns,
        extensionPaths: isset($options['extension']) ? [$options['extension']] : null,
    );
} catch (CodingAgentError $error) {
    // Almost always a model name that matches nothing or a missing API key, both worth saying
    // plainly rather than as a stack trace on a screen that was about to become a UI.
    fwrite(STDERR, Style::red($error->getMessage() . "\n"));

    exit(1);
}

// On the shell rather than in the UI, and all together: a malformed skill, a broken hook and a
// shadowed tool are their author's problem, and the author is whoever just started pig — not the
// model, and not the transcript.
foreach ($started->warnings as $warning) {
    fwrite(STDERR, Style::yellow($warning . "\n"));
}

$session = $started->session;
$contextFiles = $started->contextFiles;
$skills = $started->skills;
$fileCommands = $started->fileCommands;
$hooks = $started->hooks;
$customTools = $started->customTools;
$extensions = $started->extensions;

Timings::mark('assembled');

// Read here rather than in the parser: a missing file should be reported after the cheap
// mistakes and before the expensive setup, and it is the one positional argument that can
// fail.
try {
    $files = FileArguments::read($fileArgs, $cwd);
} catch (Throwable $error) {
    fwrite(STDERR, Style::red($error->getMessage() . "\n"));

    exit(1);
}

// The files go in front of the first message, which is the one place they can go: the model
// reading `why is this slow?` needs the code above it, not after it.
if (!$files->isEmpty()) {
    $messages = $messages === [] ? [$files->text] : [$files->before($messages[0]), ...array_slice($messages, 1)];
}

// Here rather than at the end: startup is over the moment a mode takes the screen, and a
// report printed when pig quits would be one somebody has to scroll back to find — after an
// hour of conversation, if they are still there at all.
Timings::mark('files');
Timings::report();

// Standard output belongs to the answer in every non-interactive mode, which is why every
// warning above went to standard error: something parsing JSON lines must not find a yellow
// sentence about a broken hook among them.
$exit = 0;

if ($mode === 'rpc') {
    $running = new RpcMode($session, $cwd, $hooks, $customTools, $settings, $auth);

    // One fiber around the whole program: the prompt suspends on a socket, the terminal
    // wakes on a keystroke, and both need the same loop underneath them.
    Async::run(static fn () => $running->run());
} elseif (!$interactive) {
    $printing = new PrintMode($session, $mode ?? 'text', $hooks, $customTools);
    $exit = (int) Async::run(static fn (): int => $printing->run($messages, $files->images));
} else {
    // What changed since this person last looked, shown once. Not on `-c` or `-r`: somebody
    // picking a conversation back up is in the middle of something, and upstream skips it for
    // the same reason. The version is written down *when it is shown*, so a run that showed
    // nothing does not mark the notes as seen.
    $changelog = null;

    if (!isset($options['continue']) && !isset($options['resume'])) {
        $seen = $settings->lastChangelogVersion();
        $entries = Changelog::parse();
        // If the user already saw this exact version (e.g. dev-main or same release),
        // no changelog needs to be displayed.
        if ($seen !== null && $seen === VERSION) {
            $unseen = [];
            // In a dev checkout (e.g. dev-main), self-heal settings to the latest changelog version
            // so subsequent runs compare against a valid semantic version rather than dev-main.
            if (!Version::isRelease(VERSION) && isset($entries[0])) {
                $settings->setLastChangelogVersion($entries[0]->version);
            }
        } else {
            $unseen = $seen === null ? $entries : Changelog::newerThan($entries, $seen);
        }

        if ($unseen !== []) {
            $changelog = Changelog::join($unseen);
            $toRecord = Version::isRelease(VERSION) ? VERSION : ($entries[0]->version ?? VERSION);
            $settings->setLastChangelogVersion($toRecord);
        }
    }

    $running = new InteractiveMode(
        $session,
        Palette::named($theme),
        $cwd,
        VERSION,
        $theme,
        contextFiles: $contextFiles,
        skills: $skills,
        fileCommands: $fileCommands,
        settings: $settings,
        hooks: $hooks,
        customTools: $customTools,
        auth: $auth,
        initialMessages: $messages,
        initialImages: $files->images,
        changelog: $changelog,
        extensions: $extensions,
    );

    // **Spawned, and inside the one `Async::run()` that owns the program.** It is one HTTPS
    // request to Packagist and nobody is waiting for it, so it must not be able to delay the
    // first frame: spawning puts it on the loop beside the keyboard, and the box draws itself
    // whenever the answer arrives — which is upstream's arrangement, where the promise is
    // started before the mode and read after it. Every way it can fail is null and nothing
    // drawn, including the 404 Packagist answers until pig is published.
    //
    // Interactive only. `-p`, `--mode json` and `--mode rpc` have somebody parsing standard
    // output, and upstream notifies in its interactive mode alone for the same reason.
    $checkForUpdates = !isset($options['no-update-check']) && $settings->updateCheckEnabled();

    Async::run(static function () use ($running, $checkForUpdates): void {
        if ($checkForUpdates) {
            Async::spawn(static function () use ($running): void {
                $newer = (new UpdateCheck())->newerThan(VERSION);

                if ($newer !== null) {
                    $running->sayNewVersion($newer);
                }
            });
        }

        $running->run();
    });

    // The first thing a person sees after quitting is their own shell, so the screen is
    // handed back the way it was found.
    echo "\n";

    $resume = $running->resumeCommand();

    if ($resume !== null && (!function_exists('posix_isatty') || posix_isatty(STDOUT))) {
        echo Style::dim('To resume this session: '), $resume, "\n";
    }
}

exit($exit);

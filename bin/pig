#!/usr/bin/env php
<?php

declare(strict_types=1);

/**
 * pig — a coding agent in a terminal.
 *
 *   ANTHROPIC_API_KEY=sk-ant-... bin/pig
 *   bin/pig --read-only --model sonnet:high --theme light
 *
 * Read-write by default, unlike `examples/agent.php`: this one has someone watching it,
 * and every edit shows up as a diff before the next thing happens.
 */

foreach ([__DIR__ . '/../vendor/autoload.php', __DIR__ . '/../../../autoload.php'] as $autoload) {
    if (is_file($autoload)) {
        require $autoload;

        break;
    }
}

ini_set('memory_limit', '512M');

// Upstream's `setupCli()` (`cli/setup.ts`) and `rpc-entry.ts` mark the process before anything
// else runs, so every child — a `bash` command, a hook, an MCP server — can tell it runs inside
// the agent: `AI_AGENT` is the generic marker, `PIG_CODING_AGENT` pig's own. One entry point here
// covers both, since `--mode rpc` is this file too.
putenv('PIG_CODING_AGENT=true');
putenv('AI_AGENT=pig');

use Pig\Ai\Http\HttpClient;
use Pig\Ai\Http\HttpError;
use Pig\Ai\Http\Proxy;
use Pig\Async\Async;
use Pig\CodingAgent\Export\HtmlExport;
use Pig\CodingAgent\Cli\Arguments;
use Pig\CodingAgent\Cli\AuthCommand;
use Pig\CodingAgent\Cli\InitialMessage;
use Pig\CodingAgent\Cli\UpdateCheck;
use Pig\CodingAgent\Cli\FileArguments;
use Pig\CodingAgent\Cli\ModelList;
use Pig\CodingAgent\Cli\PackageCommands;
use Pig\CodingAgent\Cli\WebDaemon;
use Pig\CodingAgent\Auth;
use Pig\CodingAgent\Changelog;
use Pig\CodingAgent\Cli\SessionPicker;
use Pig\CodingAgent\Cli\TrustPrompt;
use Pig\CodingAgent\Cli\PackageUpdateCheck;
use Pig\CodingAgent\ProjectTrust;
use Pig\CodingAgent\CodingAgent;
use Pig\CodingAgent\CodingAgentError;
use Pig\CodingAgent\CrashLog;
use Pig\CodingAgent\Keybindings;
use Pig\CodingAgent\CustomModels;
use Pig\CodingAgent\Interactive\InteractiveMode;
use Pig\CodingAgent\Rpc\RpcMode;
use Pig\CodingAgent\Mcp\McpMode;
use Pig\CodingAgent\Migrations;
use Pig\CodingAgent\PrintMode;
use Pig\CodingAgent\Session\SessionManager;
use Pig\CodingAgent\Settings;
use Pig\CodingAgent\Theme\Themes;
use Pig\CodingAgent\Tools\ToolSet;
use Pig\CodingAgent\Timings;
use Pig\CodingAgent\Version;
use Pig\CodingAgent\Web\WebMode;
use Pig\Tui\Style;

// **Asked of Composer rather than written here.** Packagist derives a package's version from its
// **tag**, and the update check below compares against Packagist — so a number written down
// anywhere in this repository is a copy that can disagree with the tag, and the way it disagrees is
// the worst one available: a build installed from tag 0.2.0 that still says 0.1.0 reports itself as
// out of date for ever. `Version` reads Composer's own answer, so there is nothing to bump.
define('VERSION', Version::current());

// Upstream's `resetTimings()` at the top of `main()`: the clock every `time()` after it measures
// from. All of them are no-ops unless `PIG_TIMING=1`, which is why they can sit in the flow
// rather than behind an `if` at each step.
Timings::resetTimings();

// What happens when pig falls over: the crash is written down for `/bug` to attach, the terminal
// is handed back, and the message is printed with the way to report it — upstream's
// `handleFatalRuntimeError()`. `$running` and `$session` are filled in below as they come to
// exist; before they do, there is no screen to restore and no session file to name.
$running = null;
$session = null;

set_exception_handler(static function (Throwable $error) use (&$running, &$session, $argv): void {
    $store = $session instanceof Pig\CodingAgent\Session\AgentSession ? $session->store() : null;
    // A private session leaves no crash record behind: `--incognito` from the start, `/incognito` since.
    $private = ($session instanceof Pig\CodingAgent\Session\AgentSession && $session->isIncognito())
        || in_array('--incognito', array_slice($argv, 1), true);
    $recorded = $private ? null : CrashLog::record('fatal_error', $error, $store?->path, getcwd() ?: '.');

    if ($running instanceof InteractiveMode) {
        try {
            $running->stop();
        } catch (Throwable) {
            // The screen is already lost; what matters is the message below.
        }
    }

    fwrite(STDERR, Style::red('pig crashed: ' . $error->getMessage() . "\n"));
    fwrite(STDERR, Style::dim($error::class . ' at ' . $error->getFile() . ':' . $error->getLine() . "\n"));

    if ($recorded !== null) {
        $how = $store !== null ? 'run `pig -r` to resume the session, then' : 'start pig and';
        fwrite(STDERR, Style::dim("To report this crash: {$how} run /bug. The crash details are attached automatically.\n"));
    }

    exit(1);
});

// Upstream's `main()` opens with this: `--offline` (or `PIG_OFFLINE` of 1/true/yes) is
// `PIG_OFFLINE=1` and `PIG_SKIP_VERSION_CHECK=1` for everything below — the model refresh, the tool
// downloads, the package and version checks all read the environment, so the flag is said once.
// Looked for anywhere in the arguments, as upstream's `args.includes("--offline")`, so a
// subcommand gets it too.
if (in_array('--offline', array_slice($argv, 1), true)
    || in_array(strtolower((string) getenv('PIG_OFFLINE')), ['1', 'true', 'yes'], true)) {
    putenv('PIG_OFFLINE=1');
    putenv('PIG_SKIP_VERSION_CHECK=1');
}

// `pig auth <check|print-api-key|print-bearer-token>` — upstream's `runAuthCommand()`, first of the
// subcommands as there. The credentials and `models.json`, and nothing else: no settings, no
// extensions, no session.
if (($argv[1] ?? '') === 'auth') {
    $auth = Auth::discover();
    $custom = CustomModels::discover();
    $custom->install($auth);

    exit((new AuthCommand(
        $auth,
        static function (string $text): void { fwrite(STDOUT, $text); },
        static function (string $text): void { fwrite(STDERR, $text); },
        $custom->problems,
    ))->run(array_slice($argv, 1)));
}

// Upstream's `setThemeJsonValidator(validateThemeJson)` at the top of `main()` (#9880): commands and
// startup selectors can load user-authored themes before any mode starts, and every one of them is
// held to the theme schema.
Themes::setThemeJsonValidator(\Pig\CodingAgent\Theme\ThemeJson::validateThemeJson(...));

// `pig install | remove | uninstall | update | list` — the package commands, upstream's
// `package-manager-cli.ts`. `update` without a target is still the self-update.
if (in_array($argv[1] ?? '', PackageCommands::COMMANDS, true)) {
    exit(PackageCommands::main(array_slice($argv, 1), getcwd() ?: '.'));
}

// `pig web start|stop|status|restart|password` — the browser UI as a daemon, and its password. `start` without `-d` becomes
// `pig --mode web` by exec, so there is one web server and not two.
if (($argv[1] ?? '') === 'web') {
    exit((new WebDaemon($argv[0]))->run(array_slice($argv, 2)));
}

// `pig mcp …` is the MCP extension's own CLI, as upstream's is: the file lives beside the
// extension rather than in a package, because what it reads and writes is the extension's.
if (($argv[1] ?? '') === 'mcp') {
    require __DIR__ . '/../extensions/pig-mcp/McpCli.php';
    exit(\PigMcp\McpCli::main(array_slice($argv, 2), getcwd() ?: '.'));
}

$arguments = Arguments::parse(array_slice($argv, 1));
$options = $arguments->options;

// Upstream's: every diagnostic said, as `Error:` or `Warning:`, and any error ends the run.
foreach ($arguments->diagnostics as $diagnostic) {
    fwrite(STDERR, $diagnostic['type'] === 'error'
        ? Style::red("Error: {$diagnostic['message']}\n")
        : Style::yellow("Warning: {$diagnostic['message']}\n"));
}

if ($arguments->errors() !== []) {
    exit(1);
}

Timings::time('parseArgs');

if (isset($options['version'])) {
    echo 'pig ' . VERSION . "\n";

    exit(0);
}

if (isset($options['help'])) {
    echo <<<TEXT
    pig — a coding agent in a terminal.

    Usage:
      pig [options] [--] [@files...] [messages...]

    Commands:
      install <source>  install a package (git:github.com/user/repo, https://…, or a path) and add it to settings
      remove <source>   remove a package and its settings entry (alias: uninstall)
      update            update pig; --extensions / --all / <source> for packages (pig update --help)
      list              list the packages in the user and project settings
      config [-l]       switch a package's extensions, skills, prompts and themes on and off
      auth <command>    print credentials or check provider readiness (pig auth --help)
      mcp               add, remove and check MCP servers (pig mcp --help)
      web               the browser UI as a server: start [-d], stop, status, restart, install (pig web --help)

    Options:
      --provider <name> the provider to look --model up in (requires --model)
      --model <id>      which model to talk to (default: claude-sonnet-4-5).
                        A part of the name will do: `sonnet`, `haiku`, `opus 4.1`.
                        Add a thinking level with a colon: `sonnet:high`.
      --models <list>   narrow this session to these models, comma-separated: the first
                        is what it opens on, and ctrl+p cycles within them. A pattern
                        may be a glob and may carry a level: `sonnet:high,'anthropic/*'`
      --list-models [s] list the models there is a key for, and stop. With a search
                        it is fuzzy over provider and id: `--list-models gem pro`
      --api-key <key>   use this key for the model's provider, this run only (requires
                        --model or --models). Not saved; beats the environment and any
                        stored sign-in.
      --system-prompt <text|file>
                        replace the default system prompt with this text or file
      --append-system-prompt <text|file>
                        add this text or file after the system prompt (repeatable)
      --proxy <url>     reach providers through this proxy, this run only:
                        `http://127.0.0.1:7890` or `socks5://127.0.0.1:7891`.
                        Otherwise `https_proxy`/`http_proxy`, with `httpProxy` in
                        the settings filling an unset HTTP_PROXY / HTTPS_PROXY.
                        `no_proxy` and `proxy.bypass` list the hosts to reach
                        directly; loopback always is.
      --no-proxy        ignore all of that and connect directly
      --offline         no startup network activity (the same as PIG_OFFLINE=1)
      -v, --version     print the version, and stop
      -h, --help        this
      --use-theme <name>
                        a theme name, or a light/dark pair like `light/dark`
                        (default: the `theme` setting, else `system`)
      --theme <path>    load a theme file or directory for this run (repeatable)
      --no-themes       look for no themes but the built-in ones and --theme's
      --thinking <l>    off, minimal, low, medium, high, xhigh, max
      -t, --tools <list>
                        which tools the model gets, comma-separated; names or patterns
                        with `*`: `--tools read,codemode,'mcp__gh__*'`
                        (default: read,bash,edit,write; also grep, find, ls)
      -xt, --exclude-tools <list>
                        take these away, after --tools; names or `*` patterns
      -nt, --no-tools   start with no tools at all, built-in, custom, extension or MCP
      -nbt, --no-builtin-tools
                        start without the built-in tools, keeping custom and extension ones
      --no-mcp          do not load the MCP extension: no servers connect, no MCP tools
      --read-only       no edit, write or bash
      --cwd <path>      where to work (default: here)
      -c, --continue    pick up the most recent session here
      -r, --resume      choose a session from a list
      --session <path|id>
                        open a session by its file, ID or ID prefix; one of another
                        project's is offered as a fork into this one
      --session-id <id> open this project's session with exactly this ID, creating it
                        if there is none
      --fork <path|id>  fork a session file or ID into a new session here
      --session-dir <d> keep every session in this one directory
      -n, --name <name> name this session, as /name does
      --no-session      do not write this session to disk
      --incognito       a private session: no session file, no logs or crash records,
                        long tool output removed on exit. Requests still go to the
                        model provider
      -a, --approve     trust project-local files for this run
      -na, --no-approve ignore project-local files for this run
      --export <file>   write a session file out as HTML and stop. A second word is
                        where it goes: `--export a.jsonl out.html`
      --skills-dir <d>  one more folder of skills, on top of the standard ones
      --skill <path>    load a skill file or directory for this run (repeatable)
      --prompt-template <path>
                        load a prompt template file or directory for this run (repeatable)
      -ns, --no-skills  start without loading any skills, wherever they live
      -np, --no-prompt-templates
                        start without loading any prompt templates
      -nc, --no-context-files
                        start without reading AGENTS.md or CLAUDE.md
      --no-hooks        start without loading ~/.pig/agent/hooks or .pig/hooks
      --no-tool-files   start without loading ~/.pig/agent/tools or .pig/tools
      -e, --extension <s>   load an extension for this run: a file, a directory, or a package
                        source (git:github.com/user/repo) cloned under tmp/ and not written to
                        settings (repeatable)
      -ne, --no-extensions
                        start without loading extensions
      --no-update-check do not ask Packagist whether there is a newer pig
      --update-check    ask even when the `update.check` setting says not to
      --verbose         show the full startup header, whatever `quietStartup` says
      --tui-mode <m>    regular or fullscreen (default: the `tuiMode` setting)
      -p, --print       say it, print the answer, exit. Also what happens when standard
                        input or output is not a terminal; piped input goes in front of
                        the first message: `git diff | pig "review this"`
      --mode <m>        text (the default), json, rpc, web or mcp. json prints every event
                        as it happens and exits, rpc reads commands as JSON lines on
                        stdin, web launches a browser-based chat UI, mcp serves this
                        conversation as an MCP server (one tool, `ask`) over Streamable HTTP.
      --mcp-host <h>, --mcp-port <n>
                        where --mode mcp listens (default: 127.0.0.1:8089).
      --mcp-stdio       --mode mcp on stdin/stdout instead, for a host that spawns its servers.

    Anything that is not an option is a message, and `@some/file` is read in front of
    the first one — an image goes in as an image. `--` ends the options, for a message
    that starts with a dash. Extensions can register options of their own; any other
    unknown option is an error.

      bin/pig "what does bin/pig do?"          ask, then carry on in the terminal
      bin/pig -p @src/Thing.php "why so slow?"  ask, print, exit
      bin/pig --mode json "..." | jq            every event, as it happens

    Environment:
      PIG_OFFLINE=1               no startup network activity, as --offline
      PIG_SKIP_VERSION_CHECK=1    do not ask Packagist whether there is a newer pig

    TEXT;

    exit(0);
}

$cwd = $options['cwd'] ?? (getcwd() ?: '.');

if (!is_dir($cwd)) {
    fwrite(STDERR, Style::red("No such directory: {$cwd}\n"));

    exit(1);
}

// Upstream's `resolveCliPaths()`: `--skill`, `--prompt-template` and `--theme` paths are the
// shell's, so a relative one is from where pig was started — not `--cwd`'s directory.
$cliPaths = static fn (string $option): array => array_map(
    static fn (string $path): string => Pig\CodingAgent\Tools\Paths::resolve($path, getcwd() ?: '.'),
    $arguments->values($option),
);

// Before any theme is looked up: upstream's `--theme <path>` loads theme files or directories for
// this run, and `--no-themes` stops looking for any elsewhere.
Themes::setCliThemePaths($cliPaths('theme'));
Themes::useThemeDiscovery(!isset($options['no-themes']));

// Which way in — upstream's `resolveAppMode()`: `--mode rpc|json` (and pig's `web` and `mcp`) as
// said; otherwise `-p`, or standard input or output not being a terminal, is print mode; and the
// terminal UI only when both are terminals. `--mode text` is the default output, not a way out of
// the terminal. Print mode with nothing to say says nothing and exits, as upstream's does.
$mode = $arguments->appMode(stream_isatty(STDIN), stream_isatty(STDOUT));
$interactive = $mode === 'interactive';
$messages = $arguments->messages;
$fileArgs = $arguments->files;

// Upstream's refusal, and its sentence: in rpc mode the conversation arrives as commands, so a
// file read here would be prepended to a prompt that never comes.
if ($mode === 'rpc' && $fileArgs !== []) {
    fwrite(STDERR, Style::red("Error: @file arguments are not supported in RPC mode\n"));

    exit(1);
}

// pig's MCP mode takes its conversation as tool calls, so neither a file nor a message has
// anywhere to go.
if ($mode === 'mcp' && ($fileArgs !== [] || $messages !== [])) {
    fwrite(STDERR, Style::red("--mode mcp takes its messages over its protocol, not as arguments.\n"));

    exit(1);
}

// Upstream's `validateForkFlags()` and `validateSessionIdFlags()`, before anything is loaded.
$conflicts = static fn (array $flags): array => array_values(array_map(
    static fn (string $flag): string => "--{$flag}",
    array_filter($flags, static fn (string $flag): bool => isset($options[$flag])),
));

// pig's own: a private session is a new one, as an incognito window opens on nothing.
if (isset($options['incognito']) && ($with = $conflicts(['session', 'session-id', 'continue', 'resume', 'fork'])) !== []) {
    fwrite(STDERR, Style::red('Error: --incognito starts a new private session and cannot be combined with ' . implode(', ', $with) . "\n"));

    exit(1);
}

// Off before anything is logged, so nothing this process says reaches `~/.pig/agent/logs`.
if (isset($options['incognito'])) {
    Pig\CodingAgent\Logger::setFileLog(false);
}

if (isset($options['fork']) && ($with = $conflicts(['session', 'continue', 'resume', 'no-session'])) !== []) {
    fwrite(STDERR, Style::red('Error: --fork cannot be combined with ' . implode(', ', $with) . "\n"));

    exit(1);
}

if (isset($options['session-id'])) {
    if (($with = $conflicts(['session', 'continue', 'resume'])) !== []) {
        fwrite(STDERR, Style::red('Error: --session-id cannot be combined with ' . implode(', ', $with) . "\n"));

        exit(1);
    }

    try {
        SessionManager::assertValidSessionId($options['session-id']);
    } catch (Throwable $error) {
        fwrite(STDERR, Style::red("Error: {$error->getMessage()}\n"));

        exit(1);
    }
}

// `--list-models` and `--export` print and exit without a session, so they open none (upstream's
// `createSessionManager()` answers them with an in-memory one), and the web shell starts none of
// its own.
$startsASession = !isset($options['list-models']) && !isset($options['export']);
$choosesASession = $startsASession && $mode !== 'web';

// The theme a screen drawn before the mode exists is drawn in — the session picker, the missing
// session directory question — from the person's own settings, since the project's are not yet
// allowed in. Upstream's `createStartupTui(startupSettingsManager)`.
$initStartupTheme = static function () use ($cwd, $options): void {
    $own = Settings::load($cwd, projectTrusted: false);
    $themeError = Themes::initTheme(Themes::resolveThemeSetting($options['use-theme'] ?? (getenv('PIG_THEME') ?: $own->theme()), Themes::getTerminalTheme()));

    if ($themeError !== null) {
        fwrite(STDERR, Style::yellow("Theme: {$themeError} Using the system theme.\n"));
    }
};

// **The session is chosen before anything bound to a directory is loaded**, as upstream's `main()`
// decides it: `--session`, `--resume` and `--session-id` may open a conversation from another
// project, and that conversation carries on in its own directory — so the project's settings,
// trust, extensions, context files and tools have to be the ones *there*, resolved only once the
// session's directory is known.
$noSession = isset($options['no-session']) || isset($options['incognito']);
$sessionId = $options['session-id'] ?? null;
$resumePath = null;
// The id a new session gets — only when `--session-id` names none of this project's.
$newSessionId = null;
// Upstream's `cwdOverride`: the directory a resumed session carries on in when its own has gone.
$sessionCwdOverride = null;

if ($choosesASession) {
    // Upstream's `sessionDir`: `--session-dir`, then `PIG_CODING_AGENT_SESSION_DIR`, then the
    // setting — the project's read before trust, as upstream reads it — and with none each project
    // has its own directory as before. A relative path is the working directory's. Set before
    // anything looks a session up.
    $sessionDir = ($options['session-dir'] ?? '') !== '' ? $options['session-dir']
        : ((string) getenv('PIG_CODING_AGENT_SESSION_DIR') !== '' ? (string) getenv('PIG_CODING_AGENT_SESSION_DIR')
        : Settings::startupSessionDir($cwd));
    SessionManager::useSessionDir($sessionDir === null ? null : Pig\CodingAgent\Tools\Paths::resolve($sessionDir, $cwd));

    // Upstream's `createSessionManager()`, in its order: `--no-session` is no file whatever else was
    // said; then `--fork`, `--session`, `--resume`, `--continue`, and `--session-id`. Resolved here rather
    // than inside the assembly, because choosing one draws on the terminal and `CodingAgent::session()`
    // has no screen: it takes a path, or nothing.

    $forkOrExit = static function (string $source) use ($cwd, $sessionId): string {
        try {
            return SessionManager::forkFrom($source, $cwd, $sessionId)->path;
        } catch (Throwable $error) {
            fwrite(STDERR, Style::red("Error: {$error->getMessage()}\n"));

            exit(1);
        }
    };

    $locateOrExit = static function (string $option) use ($cwd, $options): Pig\CodingAgent\Session\FoundSession {
        $found = $options[$option] === '' ? null : SessionManager::locate($cwd, $options[$option]);

        if ($found === null) {
            fwrite(STDERR, Style::red($options[$option] === ''
                ? "--{$option} requires a session ID or path.\n"
                : "No session found matching '{$options[$option]}'\n"));

            exit(1);
        }

        return $found;
    };

    if ($noSession) {
        // Nothing to open and nothing to write — upstream's `SessionManager.inMemory(cwd, { id })`, so
        // `--session-id` still names the session nobody saves.
        $newSessionId = $sessionId;
    } elseif (isset($options['fork'])) {
        if ($sessionId !== null && SessionManager::findById($cwd, $sessionId) !== null) {
            fwrite(STDERR, Style::red("Session already exists with id '{$sessionId}'\n"));

            exit(1);
        }

        // Wherever it is — a path, this project's, another's — forked into this one.
        $resumePath = $forkOrExit($locateOrExit('fork')->path);
    } elseif (isset($options['session'])) {
        $found = $locateOrExit('session');

        if ($found->elsewhere === null) {
            $resumePath = $found->path;
        } else {
            // Upstream's `promptConfirm()`: another project's conversation is offered as a fork into
            // this one, `[y/N]` on standard input whatever the mode, as upstream asks. The question goes
            // where the answer's reader can see it without spoiling a protocol on standard output.
            $ask = $interactive ? STDOUT : STDERR;
            fwrite($ask, Style::yellow("Session found in different project: {$found->elsewhere}") . "\n");
            fwrite($ask, 'Fork this session into current directory? [y/N] ');
            $answer = strtolower(trim((string) fgets(STDIN)));

            if ($answer !== 'y' && $answer !== 'yes') {
                fwrite($ask, Style::dim('Aborted.') . "\n");

                exit(0);
            }

            $resumePath = $forkOrExit($found->path);
        }
    } elseif (isset($options['resume'])) {
        // Upstream's `-r` takes no value: it opens the list. A list needs a terminal to be drawn on and
        // a keyboard to answer it, so without one there is nobody to choose and it is an error.
        if (!$interactive) {
            fwrite(STDERR, Style::red("--resume needs a terminal to choose on. Use --session <path|id>.\n"));

            exit(1);
        }

        // Upstream's `selectSession()`: the list even when this project has none — Tab shows every
        // project's. Escape chooses nothing, which is "No session selected" and an ordinary exit,
        // not a new session; Ctrl+C leaves without a word. Either way the list has already put the
        // terminal back, so this is an ordinary end to the program and not a signal.
        $initStartupTheme();
        $choice = SessionPicker::ask(SessionManager::listFor($cwd));

        if ($choice->quit) {
            exit(0);
        }

        if ($choice->path === null) {
            echo Style::dim('No session selected'), "\n";

            exit(0);
        }

        $resumePath = $choice->path;
    } elseif (!isset($options['continue']) && $sessionId !== null) {
        $resumePath = SessionManager::findById($cwd, $sessionId);

        if ($resumePath === null) {
            fwrite(STDERR, Style::yellow("Warning: No project session found with id '{$sessionId}'; creating a new session with that id.\n"));
            $newSessionId = $sessionId;
        }
    }


    // Upstream's `sessionManager.getCwd()` and `getMissingSessionCwdIssue()`: an opened session's
    // directory is the one everything below is loaded for; one that has gone is asked about on a
    // terminal ("continue in current cwd"), and is an error anywhere else. `--continue` stays here,
    // as upstream's `continueRecent()` does.
    if ($resumePath !== null) {
        try {
            $openedSession = SessionManager::open($resumePath);
        } catch (Throwable $error) {
            fwrite(STDERR, Style::red("Error: {$error->getMessage()}\n"));

            exit(1);
        }

        $cwdIssue = \Pig\CodingAgent\Session\SessionCwd::missingIssue($openedSession, $cwd);

        if ($cwdIssue !== null) {
            if (!$interactive) {
                fwrite(STDERR, Style::red(\Pig\CodingAgent\Session\SessionCwd::errorMessage($cwdIssue)) . "\n");

                exit(1);
            }

            $initStartupTheme();

            if (\Pig\CodingAgent\Cli\StartupSelector::ask(\Pig\CodingAgent\Session\SessionCwd::prompt($cwdIssue), ['Continue', 'Cancel']) !== 'Continue') {
                exit(0);
            }

            $sessionCwdOverride = $cwd;
        } elseif ($openedSession->cwd !== '') {
            $cwd = $openedSession->cwd;
        }
    }
}

// Whether this project's own `.pig/` may be loaded at all is decided **after** the person's own
// extensions have loaded, because they are asked first (`project_trust`), and before anything of
// the project's is read — its `.pig/settings.json` is one of the things being asked about. So the
// settings start as the person's alone, and are read again with the project's once it is trusted.
// A project with nothing to gate is trusted without a question; an extension that answers wins;
// a saved answer next; otherwise the terminal asks, and a mode with no terminal answers no.
// `--list-models` and `--export` print and exit without loading anything of the project's, so
// they are not asked either.
$trustUndecided = ProjectTrust::hasResources($cwd);
$projectTrusted = !$trustUndecided;

// The order everywhere below: what was typed, then the environment, then what was chosen
// last time, then the built-in default.
$settings = Settings::load($cwd, projectTrusted: $projectTrusted);

foreach ($settings->problems() as $problem) {
    fwrite(STDERR, Style::yellow("settings: {$problem}\n"));
}

// The prompt's theme comes from the person's own settings, since the project's are exactly what
// is not yet allowed in.
$askTrust = $interactive && $startsASession
    ? static function (array $choices) use ($cwd, $options, &$settings): ?Pig\CodingAgent\TrustChoice {
        $themeSetting = $options['use-theme'] ?? (getenv('PIG_THEME') ?: $settings->theme());
        $themeError = Themes::initTheme(Themes::resolveThemeSetting($themeSetting, Themes::getTerminalTheme()));
        if ($themeError !== null) {
            fwrite(STDERR, Style::yellow("Theme: {$themeError} Using the system theme.\n"));
        }

        return TrustPrompt::ask($cwd, $choices);
    }
    : null;

Timings::time('settings');

// Before anything opens a socket, which the first token refresh in `Auth::discover()` already
// does. `--proxy`, then the environment with the settings' `httpProxy` filling in — upstream's
// `applyHttpProxySettings()`: `HTTP_PROXY ??= httpProxy; HTTPS_PROXY ??= httpProxy`, so a variable
// already set (an empty one included) keeps its value, and the uppercase two are the ones filled
// in. Then `Proxy::fromEnvironment()` reads them as undici's `EnvHttpProxyAgent` does. A closure
// because it runs again should a trusted project's settings arrive with a timeout of its own.
$configureHttp = static function (Settings $settings) use ($options): void {
    if (isset($options['no-proxy'])) {
        HttpClient::useProxy(null);
    } else {
        try {
            $environment = getenv();

            if ($settings->httpProxy() !== null) {
                $environment['HTTP_PROXY'] ??= $settings->httpProxy();
                $environment['HTTPS_PROXY'] ??= $settings->httpProxy();
            }

            $bypass = $settings->proxyBypass();
            $proxy = isset($options['proxy']) && $options['proxy'] !== ''
                ? Proxy::parse($options['proxy'], $bypass)
                : Proxy::fromEnvironment($environment);
            // `proxy.bypass` replaces `no_proxy` when it lists something; an empty one leaves it.
            $proxy = $bypass === [] ? $proxy : $proxy?->bypassing($bypass);

            HttpClient::useProxy($proxy);
        } catch (HttpError $error) {
            // Named and fatal rather than falling back to a direct connection: in the network a
            // proxy is for, "direct" is not a worse route, it is no route, and a run that quietly
            // tried it would report the provider as unreachable and send somebody looking at the
            // wrong thing.
            fwrite(STDERR, Style::red('proxy: ' . $error->getMessage() . "\n"));

            exit(1);
        }
    }

    // Upstream's `configureHttpDispatcher(settingsManager.getHttpIdleTimeoutMs())`: how long a
    // request may sit with nothing arriving — its response head, or the next piece of its body —
    // before it fails. 300 seconds unless `httpIdleTimeoutMs` says otherwise; `disabled` (0) waits
    // forever. A setting that is not a duration says so and keeps the default.
    try {
        HttpClient::useIdleTimeout($settings->httpIdleTimeoutMs() / 1000);
    } catch (\RuntimeException $error) {
        fwrite(STDERR, Style::yellow('settings: ' . $error->getMessage() . "\n"));
    }
};
$configureHttp($settings);
Timings::time('proxy');

// Before `Auth::discover()`, because that is what these are for: a pi install left mid-upgrade
// keeps its credentials in an `oauth.json` nothing here reads, and its conversations in files
// `--resume` cannot see. Not affected by `--no-session` for the same reason `Auth` is not — the
// flag is about not writing *this conversation* down.
$movedCredentials = Migrations::run();

if ($movedCredentials !== []) {
    // Upstream's line, word for word — `main.ts` shows it as a warning and this is where pig puts
    // the warnings that happen before the UI exists, beside the settings and credential ones.
    // Said at all because pig has just written in pi's directory, which is not something to do
    // quietly; one line rather than one per provider, because it is one thing that happened.
    fwrite(STDERR, Style::yellow(
        'Migrated credentials to auth.json: ' . implode(', ', $movedCredentials) . "\n",
    ));
}

Timings::time('migrations');

// Not affected by `--no-session`, which is about not writing this conversation down. A stored
// sign-in is still the way in, and a token renewed during the run has to be kept or the next
// run starts by renewing a token that was already replaced.
$auth = Auth::discover(settings: $settings);

foreach ($auth->problems() as $problem) {
    fwrite(STDERR, Style::yellow("credentials: {$problem}\n"));
}

Timings::time('credentials');

// Before the model is resolved, because `--model my-box/qwen3-coder` has to be able to find
// one of these. Read with `--no-session` too: it is about not writing the conversation down,
// and upstream's model runtime reads `models.json` either way — as `auth.json` above is read
// either way. Read again whenever `/model` opens.
$custom = CustomModels::discover();
$custom->install($auth);

foreach ($custom->problems as $problem) {
    // Named and carried on, like a settings file that is not JSON: the built-in models are
    // still there and the session still starts. A bad line loses only itself.
    fwrite(STDERR, Style::yellow("models.json: {$problem}\n"));
}

Timings::time('customModels');

// And the providers the extensions bring, for the same reason `models.json` is read before
// `--list-models`: a listing that cannot show a model an installed extension sells is a listing
// nobody will trust about the rest. `--no-extensions` skips them. Loaded once: the result is
// handed to `CodingAgent::session()` below, because a factory run twice is an MCP server
// connected twice.
$preloadedExtensions = null;

// The packages' resources, resolved once trust is known — a project package is read only
// once the project is trusted, like its settings. A package that is not installed is cloned
// here, with a line on standard error, as upstream installs it at startup; offline it is
// skipped. The extensions go into `ExtensionLoader::load()` below; the skills, prompts and
// themes into `CodingAgent::session()`.
$packageResources = null;
$packageProgress = static function (string $type, string $action, string $source, ?string $message): void {
    if ($type === 'start' && $message !== null) {
        fwrite(STDERR, Style::dim("{$message}\n"));
    } elseif ($type === 'error') {
        fwrite(STDERR, Style::yellow("package {$source}: {$message}\n"));
    }
};

// `-e <source>`: upstream's temporary package. A git source is cloned into `<home>/tmp/extensions`
// for this run only, nothing written to the settings; a path is read as a package when it has the
// shapes and as one extension when it does not. Its skills, prompts and themes join the
// configured packages' below.
$cliExtensionPaths = [];
$temporaryResources = null;
$extensionSources = $arguments->values('extension');

// `-e builtin:<name>`: one of upstream's built-ins, by name, from pig itself. An unknown name is
// upstream's error, said and not fatal.
foreach ($extensionSources as $source) {
    if (str_starts_with($source, \Pig\CodingAgent\Extensions\BuiltinExtensions::PREFIX)) {
        $builtin = \Pig\CodingAgent\Extensions\BuiltinExtensions::pathOf($source);
        $builtin === null
            ? fwrite(STDERR, Style::yellow("Unknown built-in extension: {$source}\n"))
            : $cliExtensionPaths[] = $builtin;
    }
}

$packageSources = array_values(array_filter(
    $extensionSources,
    static fn (string $source): bool => !str_starts_with($source, \Pig\CodingAgent\Extensions\BuiltinExtensions::PREFIX),
));

if ($packageSources !== []) {
    $manager = new \Pig\CodingAgent\Packages\PackageManager($cwd, $settings);
    $manager->setProgressCallback($packageProgress);

    try {
        // Every `-e`, as upstream's "can be used multiple times".
        $temporaryResources = $manager->resolveExtensionSources($packageSources, temporary: true);
        $cliExtensionPaths = [...$cliExtensionPaths, ...$temporaryResources->enabled('extensions')];
    } catch (\Pig\CodingAgent\Packages\PackageError $error) {
        fwrite(STDERR, Style::red("--extension: {$error->getMessage()}\n"));

        exit(1);
    }
}

$resolvePackages = static function (bool $trusted) use ($cwd, &$packageResources, $packageProgress, $temporaryResources): \Pig\CodingAgent\Packages\ResolvedPaths {
    if ($packageResources !== null) {
        return $packageResources;
    }

    $manager = new \Pig\CodingAgent\Packages\PackageManager($cwd, Settings::load($cwd, projectTrusted: $trusted));
    $manager->setProgressCallback($packageProgress);

    try {
        $resolved = $manager->resolve();
    } catch (\Pig\CodingAgent\Packages\PackageError $error) {
        fwrite(STDERR, Style::yellow("packages: {$error->getMessage()}\n"));
        $resolved = new \Pig\CodingAgent\Packages\ResolvedPaths();
    }

    // The temporary package's other resources ride along; its extensions went to the loader
    // as `$cliExtensionPaths`, so they are not listed twice.
    return $packageResources = $temporaryResources === null ? $resolved : new \Pig\CodingAgent\Packages\ResolvedPaths(
        $resolved->extensions,
        [...$resolved->skills, ...$temporaryResources->skills],
        [...$resolved->prompts, ...$temporaryResources->prompts],
        [...$resolved->themes, ...$temporaryResources->themes],
    );
};

// Once trust is decided, whichever way: the project's settings join the person's, and what was
// read off the person's alone is read again with them.
$settleTrust = static function (bool $trusted) use (&$projectTrusted, &$settings, $cwd, $configureHttp): void {
    $projectTrusted = $trusted;

    if ($trusted) {
        $own = $settings->problems();
        $settings = Settings::load($cwd, projectTrusted: true);

        foreach (array_diff($settings->problems(), $own) as $problem) {
            fwrite(STDERR, Style::yellow("settings: {$problem}\n"));
        }

        \Pig\CodingAgent\Extensions\ExtensionApi::useSettings($settings);
        $configureHttp($settings);
    }

    // The theme files the settings and the directories give, so the theme picked below can be one
    // of them; the project's `.pig/themes` waits for trust like its settings do. `session()` hands
    // in the full list again, the packages' included.
    Themes::setResolvedThemeFiles((new \Pig\CodingAgent\Packages\PackageManager($cwd, $settings))->resolveLocalResources($trusted)->enabled('themes'));
};

// `project_trust`, over the extensions loaded before the project's: the first yes or no wins over
// a saved answer and the prompt. A handler that threw is one line on the shell, as upstream prints it.
// Upstream's `--approve` / `--no-approve`: this run's answer, ahead of every other.
$trustOverride = isset($options['approve']) ? true : (isset($options['no-approve']) ? false : null);

$decideTrust = static function (array $loaded) use ($cwd, $askTrust, $settleTrust, &$settings, $trustOverride): bool {
    $runner = new \Pig\CodingAgent\Hooks\HookRunner(
        array_map(static fn ($ext) => new \Pig\CodingAgent\Hooks\LoadedHook($ext->path, $ext->resolved, $ext->api), $loaded),
        $cwd,
    );
    $runner->initialize(static fn () => null);
    $runner->onError(static function (\Pig\CodingAgent\Hooks\HookError $error): void {
        fwrite(STDERR, Style::yellow("Extension \"{$error->hookPath}\" {$error->event} error: {$error->error}\n"));
    });

    $trusted = ProjectTrust::resolve($cwd, $askTrust, extensions: $runner, default: $settings->defaultProjectTrust(), override: $trustOverride);
    $settleTrust($trusted);

    return $trusted;
};

// On first run on a fresh machine, ensure bundled extensions (pig-antigravity, pig-computer, etc.)
// are populated into ~/.pig/agent/extensions so they are available out of the box.
if (!isset($options['no-extensions']) && !is_dir(\Pig\CodingAgent\Config::home() . '/extensions')) {
    \Pig\CodingAgent\Cli\SelfUpdate::ensureBundledExtensions();
}

// Upstream's `--no-extensions` turns off every extension but the ones `-e` names.
if ((!isset($options['no-extensions']) || $cliExtensionPaths !== []) && $mode !== 'web') {
    \Pig\CodingAgent\Extensions\ExtensionApi::useSettings($settings);
    $preloadedExtensions = \Pig\CodingAgent\Extensions\ExtensionLoader::load(
        $cwd,
        $settings->extensions(),
        $cliExtensionPaths,
        auth: $auth,
        projectTrusted: $trustUndecided ? $decideTrust : true,
        disabled: array_values(array_unique([...$settings->disabledExtensions(), ...(isset($options['no-mcp']) ? ['pig-mcp'] : [])])),
        projectConfigured: static fn (): array => $settings->extensions(),
        packageExtensions: static fn (bool $trusted): array => $resolvePackages($trusted)->enabled('extensions'),
        discover: !isset($options['no-extensions']),
        // Upstream's built-ins, last; none under `--no-extensions`, and `--no-mcp` leaves `mcp` out.
        builtins: isset($options['no-extensions']) ? [] : $settings->builtinExtensions(isset($options['no-mcp']) ? ['mcp'] : []),
    );
}

// With no extensions to ask, the question goes straight to the saved answer and the prompt.
if ($trustUndecided && $preloadedExtensions === null) {
    $settleTrust(ProjectTrust::resolve($cwd, $askTrust, default: $settings->defaultProjectTrust(), override: $trustOverride));
}

if (!$trustUndecided) {
    $settleTrust(true);
}

Timings::time('extensions');

// What `--use-theme` or `PIG_THEME` said, else the `theme` setting: a theme name or a light/dark pair.
// Null is upstream's default, the system theme.
$themeSetting = $options['use-theme'] ?? (getenv('PIG_THEME') ?: $settings->theme());


// The web shell starts no session of its own: each tab in the page is a `pig --mode rpc` child,
// and the child does everything from here down — model, hooks, extensions, the lot — in its own
// process. What the shell needs is what it serves without a conversation: the page, the
// credentials (`/api/models`, `/api/accounts`) and the declared providers, all of which are
// loaded above. So it leaves here, before `CodingAgent::session()` would have built a session
// that nothing in the browser could reach.
if ($mode === 'web') {
    $webPort = isset($options['web-port']) && ctype_digit((string) $options['web-port']) ? (int) $options['web-port'] : WebDaemon::DEFAULT_PORT;
    $webHost = isset($options['web-host']) && $options['web-host'] !== '' ? (string) $options['web-host'] : WebDaemon::DEFAULT_HOST;
    $running = new WebMode($cwd, $webPort, $webHost, auth: $auth, openBrowser: !isset($options['no-browser']));

    exit((int) Async::run(static fn (): int => $running->run()));
}

// After the declared providers, not before: a listing that cannot show the model somebody
// just added to `models.json` is a listing they will not trust about the rest either. It
// costs a settings read and a file read to get here, which nobody notices on a command that
// prints and exits.
//
// `--list-models` is upstream's name for it, and pig's `--models` used to be. They had to swap:
// upstream's `--models` takes patterns and *scopes* the session, so the same word meant two
// different things in the two tools — one of which prints and exits.
if (isset($options['list-models'])) {
    echo ModelList::render($options['list-models'], $auth), "\n";

    exit(0);
}

// Prints and exits, like `--list-models`, and for the same reason it sits this far down: the theme
// decides what the page looks like, and the theme comes from the settings. A session on disk and
// no wish to reopen it had no way out until this — `/export` needs a running session and the RPC
// `export` command needs a host.
if (isset($options['export'])) {
    try {
        // The write first and the sentence after, not `echo 'Exported to: ', …` with the call as
        // the second argument: `echo` writes left to right, so a failure printed the prefix and
        // then the error under it. Found by running it, which is the only way that shows.
        $written = HtmlExport::fromFile(
            $options['export'],
            $arguments->messages[0] ?? null,
            $cwd,
            Themes::resolveThemeSetting($themeSetting, Themes::getTerminalTheme()) ?? Themes::SYSTEM_THEME_NAME,
        );

        echo "Exported to: {$written}\n";
    } catch (Throwable $problem) {
        fwrite(STDERR, Style::red($problem->getMessage() . "\n"));

        exit(1);
    }

    exit(0);
}

// A theme named on the command line or in the environment that matches nothing is one line on the
// shell, before anything has been loaded. One in the settings is reported by the interactive mode's
// theme controller instead, which falls back to the system theme as upstream's does.
if (isset($options['use-theme']) || (getenv('PIG_THEME') ?: '') !== '') {
    $available = Themes::getAvailableThemes();
    $named = Themes::parseAutoThemeSetting($themeSetting);
    foreach ($named === null ? [$themeSetting] : [$named['lightTheme'], $named['darkTheme']] as $wanted) {
        if (!in_array($wanted, $available, true)) {
            fwrite(STDERR, Style::red("No theme called '{$wanted}'. Available themes: " . implode(', ', $available) . ".\n"));
            foreach (Themes::getCustomThemeErrors() as $problem) {
                fwrite(STDERR, Style::yellow("Skipped theme {$problem}\n"));
            }

            exit(1);
        }
    }
}

// Upstream's `initTheme()` in `main()`, for every mode: the session picker draws before the
// interactive mode exists, and a hook asking `ui->theme()` in print mode gets an answer. The
// interactive mode's theme controller takes over from here.
// Upstream's `setCapabilityOverrides()` in `main()`: `terminal.images`, `trueColor` and `hyperlinks`
// from the settings, before the theme picks its colour mode from them.
\Pig\Tui\Images\TerminalImage::setCapabilityOverrides($settings->terminalCapabilityOverrides());
$themeError = Themes::initTheme(Themes::resolveThemeSetting($themeSetting, Themes::getTerminalTheme()));
if ($themeError !== null && !$interactive) {
    fwrite(STDERR, Style::yellow("Theme: {$themeError} Using the system theme.\n"));
}

// Which built-in tools the model gets. Checked here rather than inside the assembly for the same
// reason the theme is: a name that matches nothing should be one line on the shell, before anything
// has been loaded, and it should list what the names are.
// Split here rather than in `session()`, which is the same division `--tools` follows: the flag's
// spelling is the command line's business and what it resolves to is the library's.
$modelPatterns = isset($options['models'])
    ? array_values(array_filter(array_map('trim', explode(',', $options['models']))))
    : null;

if ($modelPatterns === []) {
    fwrite(STDERR, Style::red("--models needs at least one model or pattern after it.\n"));

    exit(1);
}

// `--tools` and `--exclude-tools` take names or `*` patterns, and which names exist is only
// known once the custom tools have loaded — so `CodingAgent::session()` is what refuses a typo,
// by name. The flag's spelling is the command line's business and what it resolves to is the
// library's, which is `--models`' division too.
$toolNames = null;
$excludeTools = null;

if (isset($options['tools'])) {
    $toolNames = array_values(array_filter(array_map('trim', explode(',', $options['tools']))));

    if ($toolNames === []) {
        fwrite(STDERR, Style::red('--tools needs at least one name or pattern: ' . implode(', ', ToolSet::ALL) . ", …\n"));

        exit(1);
    }
}

if (isset($options['exclude-tools'])) {
    $excludeTools = array_values(array_filter(array_map('trim', explode(',', $options['exclude-tools']))));

    if ($excludeTools === []) {
        fwrite(STDERR, Style::red("--exclude-tools needs at least one name or pattern after it.\n"));

        exit(1);
    }
}

// Upstream's `--name`: trimmed, and refused when nothing is left, before anything has loaded.
$sessionName = null;

if (isset($options['name'])) {
    $sessionName = trim($options['name']);

    if ($sessionName === '') {
        fwrite(STDERR, Style::red("Error: --name requires a non-empty value\n"));

        exit(1);
    }
}

// Everything from the model to the restored conversation. It lives in `CodingAgent::session()`
// rather than here for the reason `Cli\Arguments` and `Cli\SignIn` are classes: a script ending in
// `exit()` cannot be called twice, so two hundred lines of resolution order had no test. The one
// call, for this directory at startup and for another one when a session from there is resumed
// (`$createRuntime` below): the command line's options are the same for both, as upstream's
// runtime factory closes over its `parsed` arguments.
$assemble = static function (
    string $cwd,
    Settings $settings,
    bool $projectTrusted,
    ?string $resume,
    bool $continue,
    ?string $cwdOverride,
    ?array $preloadedExtensions,
    \Pig\CodingAgent\Packages\ResolvedPaths $packageResources,
    ?string $newSessionId,
) use ($auth, $options, $noSession, $toolNames, $modelPatterns, $cliExtensionPaths, $excludeTools, $cliPaths, $arguments, &$session): Pig\CodingAgent\StartedSession {
    return CodingAgent::session(
        $cwd,
        $settings,
        $auth,
        model: $options['model'] ?? null,
        thinking: $options['thinking'] ?? null,
        apiKey: $options['api-key'] ?? null,
        resume: $resume,
        continue: $continue,
        save: !$noSession,
        readOnly: isset($options['read-only']),
        withHooks: !isset($options['no-hooks']),
        withSkills: !isset($options['no-skills']),
        withTools: !isset($options['no-tool-files']),
        withExtensions: !isset($options['no-extensions']),
        skillsDir: $options['skills-dir'] ?? null,
        tools: $toolNames,
        models: $modelPatterns,
        extensionPaths: $cliExtensionPaths === [] ? null : $cliExtensionPaths,
        projectTrusted: $projectTrusted,
        excludeTools: $excludeTools,
        // `--no-mcp`: upstream's `disabledBuiltinExtensions: ["mcp"]`, by pig's directory name.
        disabledExtensions: array_values(array_unique([...$settings->disabledExtensions(), ...(isset($options['no-mcp']) ? ['pig-mcp'] : [])])),
        // Every option, for the flags extensions declare (`registerFlag()`); the parser does not
        // refuse an option it has not heard of, which is what makes `--my-flag` reachable at all.
        flags: $options,
        // Loaded before, once, so `--list-models` could see them; their problems come back in
        // `$warnings` with everybody else's.
        preloadedExtensions: $preloadedExtensions,
        packageResources: $packageResources,
        // Upstream's `noTools`: `--no-tools` wins over `--no-builtin-tools`.
        noTools: isset($options['no-tools']) ? 'all' : (isset($options['no-builtin-tools']) ? 'builtin' : null),
        withPromptTemplates: !isset($options['no-prompt-templates']),
        withContextFiles: !isset($options['no-context-files']),
        skillPaths: $cliPaths('skill'),
        promptTemplatePaths: $cliPaths('prompt-template'),
        systemPrompt: $options['system-prompt'] ?? null,
        appendSystemPrompt: $arguments->values('append-system-prompt') === [] ? null : $arguments->values('append-system-prompt'),
        provider: $options['provider'] ?? null,
        sessionId: $newSessionId,
        cwdOverride: $cwdOverride,
        // Also for the runtime `/resume` builds in another directory: a private session stays private.
        incognito: isset($options['incognito']) || ($session instanceof Pig\CodingAgent\Session\AgentSession && $session->isIncognito()),
    );
};

// Upstream's `CreateAgentSessionRuntimeFactory`, for `AgentSession::switchTo()`'s `$relocate`: a
// session from another directory gets a runtime built for that directory — its trust (asked once
// per directory, through `$askTrust` when the mode has a screen to ask on, upstream's
// `projectTrustByCwd`), its settings, its packages and extensions, and then everything
// `CodingAgent::session()` builds. What the previous runtime's extensions registered process-wide
// goes first, as `/reload` clears it, and `models.json` is applied again over what loads.
$trustByCwd = [$cwd => $projectTrusted];
$createRuntime = static function (string $runtimeCwd, SessionManager $opened, ?Closure $askTrust) use (&$trustByCwd, $trustOverride, $assemble, $auth, $options, $cliExtensionPaths, $temporaryResources): Pig\CodingAgent\StartedSession {
    $trusted = $trustByCwd[$runtimeCwd] ??= ProjectTrust::resolve(
        $runtimeCwd,
        $askTrust,
        default: Settings::load($runtimeCwd, projectTrusted: false)->defaultProjectTrust(),
        override: $trustOverride,
    );
    $runtimeSettings = Settings::load($runtimeCwd, projectTrusted: $trusted);
    \Pig\CodingAgent\Extensions\ExtensionApi::useSettings($runtimeSettings);

    \Pig\Ai\Extension\ProviderRegistry::forget();
    \Pig\CodingAgent\Extensions\ExtensionApi::forgetHttpRoutes();
    \Pig\CodingAgent\Extensions\ExtensionApi::forgetFlags();
    \Pig\CodingAgent\McpServerRegistry::reset();
    \Pig\CodingAgent\VirtualModelRegistry::reset();

    // Not installed here: a switch is not the moment to clone, as `/reload` does not.
    try {
        $resolved = (new \Pig\CodingAgent\Packages\PackageManager($runtimeCwd, $runtimeSettings))->resolve(static fn (): string => 'skip');
    } catch (\Pig\CodingAgent\Packages\PackageError $error) {
        throw new CodingAgentError("packages: {$error->getMessage()}", previous: $error);
    }

    $packages = $temporaryResources === null ? $resolved : new \Pig\CodingAgent\Packages\ResolvedPaths(
        $resolved->extensions,
        [...$resolved->skills, ...$temporaryResources->skills],
        [...$resolved->prompts, ...$temporaryResources->prompts],
        [...$resolved->themes, ...$temporaryResources->themes],
    );

    $extensions = isset($options['no-extensions']) && $cliExtensionPaths === []
        ? null
        : \Pig\CodingAgent\Extensions\ExtensionLoader::load(
            $runtimeCwd,
            $runtimeSettings->extensions(),
            $cliExtensionPaths,
            auth: $auth,
            projectTrusted: $trusted,
            disabled: array_values(array_unique([...$runtimeSettings->disabledExtensions(), ...(isset($options['no-mcp']) ? ['pig-mcp'] : [])])),
            projectConfigured: static fn (): array => $runtimeSettings->extensions(),
            packageExtensions: static fn (bool $trusted): array => $packages->enabled('extensions'),
            discover: !isset($options['no-extensions']),
            builtins: isset($options['no-extensions']) ? [] : $runtimeSettings->builtinExtensions(isset($options['no-mcp']) ? ['mcp'] : []),
        );

    CustomModels::discover()->install($auth);

    return $assemble($runtimeCwd, $runtimeSettings, $trusted, $opened->path, false, $runtimeCwd, $extensions, $packages, null);
};

try {
    $started = $assemble(
        $cwd,
        $settings,
        $projectTrusted,
        $resumePath,
        !$noSession && isset($options['continue']),
        $sessionCwdOverride,
        $preloadedExtensions,
        // Resolved above with the extensions, or now — `--no-extensions` skips that loader.
        $resolvePackages($projectTrusted),
        $newSessionId,
    );
} catch (CodingAgentError $error) {
    // Almost always a model name that matches nothing or a missing API key, both worth saying
    // plainly rather than as a stack trace on a screen that was about to become a UI.
    fwrite(STDERR, Style::red($error->getMessage() . "\n"));

    exit(1);
}

// On the shell rather than in the UI, and all together: a malformed skill, a broken hook and a
// shadowed tool are their author's problem, and the author is whoever just started pig — not the
// model, and not the transcript.
foreach ($started->warnings as $warning) {
    fwrite(STDERR, Style::yellow($warning . "\n"));
}

// Upstream's `applyExtensionFlagValues()`: an option no list names is an extension's, and once the
// extensions have loaded, one that none of them registered is an error — as is a string flag
// given no value.
$declaredFlags = Pig\CodingAgent\Extensions\ExtensionApi::declaredFlags();
$unregistered = array_values(array_diff(array_keys($arguments->unknownFlags), array_keys($declaredFlags)));
$flagErrors = [];

foreach ($arguments->unknownFlags as $name => $value) {
    if (isset($declaredFlags[$name]) && $declaredFlags[$name]['type'] !== 'boolean' && $value === true) {
        $flagErrors[] = "Extension flag \"--{$name}\" requires a value";
    }
}

if ($unregistered !== []) {
    $flagErrors[] = 'Unknown option' . (count($unregistered) === 1 ? '' : 's') . ': '
        . implode(', ', array_map(static fn (string $name): string => "--{$name}", $unregistered));
}

if ($flagErrors !== []) {
    foreach ($flagErrors as $problem) {
        fwrite(STDERR, Style::red("Error: {$problem}\n"));
    }

    exit(1);
}

$session = $started->session;

// Upstream's `sessionManager.appendSessionInfo(name)`, onto the file before the first turn. With
// `--no-session` there is no file for the name to be in.
if ($sessionName !== null) {
    $started->store?->setSessionName($sessionName);
}

$contextFiles = $started->contextFiles;
$skills = $started->skills;
$fileCommands = $started->fileCommands;
$hooks = $started->hooks;
$customTools = $started->customTools;
$extensions = $started->extensions;

Timings::time('assembled');

// Read here rather than in the parser: a missing file should be reported after the cheap
// mistakes and before the expensive setup, and it is the one positional argument that can
// fail.
try {
    $files = FileArguments::read($fileArgs, $cwd, $settings->imageAutoResize());
} catch (Throwable $error) {
    fwrite(STDERR, Style::red($error->getMessage() . "\n"));

    exit(1);
}

// Upstream's `readPipedStdin()`, not in rpc mode — its standard input is the protocol — nor in pig's
// web and mcp modes, which serve rather than prompt. Piped input is print mode already
// (`appMode()`), so what remains is to put it in front.
$stdinContent = in_array($mode, ['rpc', 'web', 'mcp'], true) ? null : InitialMessage::readPipedStdin();

// Upstream's `buildInitialMessage()`: stdin, then the files, then the first message — the model
// reading `why is this slow?` needs the code above it, not after it.
$messages = InitialMessage::build($stdinContent, $files->text, $messages);

// Here rather than at the end: startup is over the moment a mode takes the screen, and a
// report printed when pig quits would be one somebody has to scroll back to find — after an
// hour of conversation, if they are still there at all.
Timings::time('files');
Timings::printTimings();

// Standard output belongs to the answer in every non-interactive mode, which is why every
// warning above went to standard error: something parsing JSON lines must not find a yellow
// sentence about a broken hook among them.
$exit = 0;

if ($mode === 'rpc') {
    $running = new RpcMode($session, $cwd, $hooks, $customTools, $settings, $auth, createRuntime: $createRuntime);

    // One fiber around the whole program: the prompt suspends on a socket, the terminal
    // wakes on a keystroke, and both need the same loop underneath them.
    Async::run(static fn () => $running->run());
} elseif ($mode === 'mcp') {
    $mcpPort = isset($options['mcp-port']) && ctype_digit((string) $options['mcp-port']) ? (int) $options['mcp-port'] : 8089;
    $mcpHost = isset($options['mcp-host']) && $options['mcp-host'] !== '' ? (string) $options['mcp-host'] : '127.0.0.1';
    $serving = new McpMode($session, $mcpPort, $mcpHost, $hooks, $customTools, stdio: isset($options['mcp-stdio']));
    $exit = (int) Async::run(static fn (): int => $serving->run());
} elseif (!$interactive) {
    $printing = new PrintMode($session, $mode === 'json' ? 'json' : 'text', $hooks, $customTools);
    $exit = (int) Async::run(static fn (): int => $printing->run($messages, $files->images));
} else {
    // What changed since this person last looked, shown once. Not on `-c` or `-r`: somebody
    // picking a conversation back up is in the middle of something, and upstream skips it for
    // the same reason. The version is written down *when it is shown*, so a run that showed
    // nothing does not mark the notes as seen.
    $changelog = null;

    // Not in a private session, which writes nothing to the settings it did not ask to: the notes
    // wait for the next ordinary start.
    if (!isset($options['continue']) && !isset($options['resume']) && !isset($options['incognito'])) {
        $seen = $settings->lastChangelogVersion();
        $entries = Changelog::parse();

        if ($seen === null) {
            // Fresh install — record current version so later upgrades compare against it,
            // but do not dump the whole project history onto the screen on first run (matching upstream pi).
            $toRecord = Version::isRelease(VERSION) ? VERSION : ($entries[0]->version ?? VERSION);
            $settings->setLastChangelogVersion($toRecord);
        } elseif ($seen === VERSION) {
            // In a dev checkout (e.g. dev-main), self-heal settings to the latest changelog version
            // so subsequent runs compare against a valid semantic version rather than dev-main.
            if (!Version::isRelease(VERSION) && isset($entries[0])) {
                $settings->setLastChangelogVersion($entries[0]->version);
            }
        } else {
            $unseen = Changelog::newerThan($entries, $seen);
            if ($unseen !== []) {
                $changelog = Changelog::join($unseen);
                $toRecord = Version::isRelease(VERSION) ? VERSION : ($entries[0]->version ?? VERSION);
                $settings->setLastChangelogVersion($toRecord);
            }
        }
    }

    // `~/.pig/agent/keybindings.json`, read here and complained about here like every other
    // file of the person's: a key this cannot read is a line on the shell, not a binding that
    // silently never fires.
    $keybindings = Keybindings::load();

    foreach ($keybindings->problems() as $problem) {
        fwrite(STDERR, Style::yellow($problem . "\n"));
    }

    $running = new InteractiveMode(
        $session,
        $cwd,
        VERSION,
        // Only an explicit `--use-theme` or `PIG_THEME`, which overrides the setting without saving
        // it; otherwise the controller reads the setting.
        $options['use-theme'] ?? (getenv('PIG_THEME') ?: null),
        contextFiles: $contextFiles,
        skills: $skills,
        fileCommands: $fileCommands,
        settings: $settings,
        hooks: $hooks,
        customTools: $customTools,
        auth: $auth,
        initialMessages: $messages,
        initialImages: $files->images,
        changelog: $changelog,
        extensions: $extensions,
        projectTrusted: $projectTrusted,
        keybindings: $keybindings,
        tuiMode: $options['tui-mode'] ?? null,
        verbose: isset($options['verbose']),
        createRuntime: $createRuntime,
    );

    // **Spawned, and inside the one `Async::run()` that owns the program.** It is one HTTPS
    // request to Packagist and nobody is waiting for it, so it must not be able to delay the
    // first frame: spawning puts it on the loop beside the keyboard, and the box draws itself
    // whenever the answer arrives — which is upstream's arrangement, where the promise is
    // started before the mode and read after it. Every way it can fail is null and nothing
    // drawn, including the 404 Packagist answers until pig is published.
    //
    // Interactive only. `-p`, `--mode json` and `--mode rpc` have somebody parsing standard
    // output, and upstream notifies in its interactive mode alone for the same reason.
    // `--update-check` asks whatever the setting says; `PIG_SKIP_VERSION_CHECK` and `PIG_OFFLINE`
    // (which `--offline` sets) are read by `UpdateCheck` itself, as upstream's `checkForNewPiVersion()`.
    $checkForUpdates = isset($options['update-check']) || (!isset($options['no-update-check']) && $settings->updateCheckEnabled());

    Async::run(static function () use ($running, $checkForUpdates, $cwd): void {
        if ($checkForUpdates) {
            Async::spawn(static function () use ($running): void {
                $newer = (new UpdateCheck())->newerThan(VERSION);

                if ($newer !== null) {
                    $running->sayNewVersion($newer);
                }
            });

            Async::spawn(static function () use ($running, $cwd): void {
                $updates = (new PackageUpdateCheck())->checkForUpdates($cwd);

                if ($updates !== []) {
                    $running->sayPackageUpdates($updates);
                }
            });
        }

        $running->run();
    });

    // The first thing a person sees after quitting is their own shell, so the screen is
    // handed back the way it was found.
    echo "\n";

    $resume = $running->resumeCommand();

    if ($resume !== null && (!function_exists('posix_isatty') || posix_isatty(STDOUT))) {
        echo Style::dim('To resume this session: '), $resume, "\n";
    }

    // Upstream's `handleFatalRuntimeError()` ends the program with 1.
    $exit = $running->exitCode();
}

exit($exit);

#!/usr/bin/env php
<?php

declare(strict_types=1);

/**
 * pig — a coding agent in a terminal.
 *
 *   ANTHROPIC_API_KEY=sk-ant-... bin/pig
 *   bin/pig --read-only --model sonnet:high --theme light
 *
 * Read-write by default, unlike `examples/agent.php`: this one has someone watching it,
 * and every edit shows up as a diff before the next thing happens.
 */

foreach ([__DIR__ . '/../vendor/autoload.php', __DIR__ . '/../../../autoload.php'] as $autoload) {
    if (is_file($autoload)) {
        require $autoload;

        break;
    }
}

use Pig\Agent\ThinkingLevel;
use Pig\Async\Async;
use Pig\CodingAgent\Cli\Arguments;
use Pig\CodingAgent\Cli\FileArguments;
use Pig\CodingAgent\Cli\ModelList;
use Pig\CodingAgent\Auth;
use Pig\CodingAgent\Changelog;
use Pig\CodingAgent\Cli\SessionPicker;
use Pig\CodingAgent\CodingAgent;
use Pig\CodingAgent\CustomModels;
use Pig\CodingAgent\CustomTools\CustomToolApi;
use Pig\CodingAgent\CustomTools\CustomToolLoader;
use Pig\CodingAgent\CustomTools\CustomToolSet;
use Pig\CodingAgent\Hooks\HookLoader;
use Pig\CodingAgent\Hooks\HookRunner;
use Pig\CodingAgent\Interactive\InteractiveMode;
use Pig\CodingAgent\Rpc\RpcMode;
use Pig\CodingAgent\Migrations;
use Pig\CodingAgent\ModelResolver;
use Pig\CodingAgent\PrintMode;
use Pig\CodingAgent\Prompt\ContextFiles;
use Pig\CodingAgent\Prompt\Skills;
use Pig\CodingAgent\Prompt\SlashCommands;
use Pig\CodingAgent\Session\AgentSession;
use Pig\CodingAgent\Session\SessionManager;
use Pig\CodingAgent\Settings;
use Pig\CodingAgent\Theme\Palette;
use Pig\CodingAgent\Timings;
use Pig\CodingAgent\Tools\ToolSet;
use Pig\Tui\Style;

const VERSION = '0.1.0';

// The first mark is an anchor and costs nothing; every one after it is the gap since the
// last. All of them are no-ops unless `PIG_TIMING=1`, which is why they can sit in the flow
// rather than behind an `if` at each step.
Timings::mark('start');

$arguments = Arguments::parse(array_slice($argv, 1));
$options = $arguments->options;
Timings::mark('parseArgs');

if (isset($options['version'])) {
    echo 'pig ' . VERSION . "\n";

    exit(0);
}

if (isset($options['help'])) {
    echo <<<TEXT
    pig — a coding agent in a terminal.

      --model <id>      which model to talk to (default: claude-sonnet-4-5).
                        A part of the name will do: `sonnet`, `haiku`, `opus 4.1`.
                        Add a thinking level with a colon: `sonnet:high`.
      --models [search] list the models there are, and stop. With a search it is
                        fuzzy over provider and id: `--models gem pro`
      --api-key <key>   use this key for the model's provider, this run only.
                        Not saved; beats the environment and any stored sign-in.
      -v, --version     print the version, and stop
      -h, --help        this
      --theme <name>    dark or light (default: dark)
      --thinking <l>    off, minimal, low, medium, high, xhigh
      --read-only       no edit, write or bash
      --cwd <path>      where to work (default: here)
      -c, --continue    pick up the most recent session here
      -r, --resume      choose from a list; `--resume <file>` opens one by path
      --no-save         do not write this session to disk
      --skills-dir <d>  one more folder of skills, on top of the standard ones
      --no-hooks        start without loading ~/.pig/hooks or .pig/hooks
      --no-tools        start without loading ~/.pig/tools or .pig/tools
      -p, --print       say it, print the answer, exit — the same as --mode text
      --mode <m>        text, json or rpc. Any of them leaves the terminal behind:
                        text prints the last answer, json prints every event as it
                        happens, rpc reads commands as JSON lines on stdin.

    Anything that is not an option is a message, and `@some/file` is read in front of
    the first one — an image goes in as an image. `--` ends the options, for a message
    that starts with a dash.

      bin/pig "what does bin/pig do?"          ask, then carry on in the terminal
      bin/pig -p @src/Thing.php "why so slow?"  ask, print, exit
      bin/pig --mode json -p "..." | jq        every event, as it happens

    TEXT;

    exit(0);
}

$cwd = $options['cwd'] ?? (getcwd() ?: '.');

if (!is_dir($cwd)) {
    fwrite(STDERR, Style::red("No such directory: {$cwd}\n"));

    exit(1);
}

// Which way in. Upstream's rule, kept: `--mode` given at all means no terminal, and `-p` is
// the short way of saying `--mode text`. So the terminal is the default and nothing but the
// absence of both selects it.
$mode = $arguments->mode();

if (!$arguments->isKnownMode()) {
    fwrite(STDERR, Style::red("No mode called '{$mode}'. There is " . implode(', ', Arguments::MODES) . ".\n"));

    exit(1);
}

$interactive = $arguments->isInteractive();
$messages = $arguments->messages;
$fileArgs = $arguments->files;

// Refused rather than ignored, as upstream refuses it: in rpc mode the conversation arrives
// as commands, so a file read here would be prepended to a prompt that never comes.
if ($mode === 'rpc' && ($fileArgs !== [] || $messages !== [])) {
    fwrite(STDERR, Style::red("--mode rpc takes its messages as commands, not as arguments.\n"));

    exit(1);
}

if (!$interactive && $messages === [] && $fileArgs === []) {
    fwrite(STDERR, Style::red("Nothing to say. Pass a message, or leave off --mode for the terminal.\n"));

    exit(1);
}

// The order everywhere below: what was typed, then the environment, then what was chosen
// last time, then the built-in default.
$settings = isset($options['no-save']) ? Settings::inMemory() : Settings::load($cwd);

foreach ($settings->problems() as $problem) {
    fwrite(STDERR, Style::yellow("settings: {$problem}\n"));
}

Timings::mark('settings');

// Before `Auth::discover()`, because that is what these are for: a pi install left mid-upgrade
// keeps its credentials in an `oauth.json` nothing here reads, and its conversations in files
// `--resume` cannot see. Not affected by `--no-save` for the same reason `Auth` is not — the flag
// is about not writing *this conversation* down.
$movedCredentials = Migrations::run();

if ($movedCredentials !== []) {
    // Upstream's line, word for word — `main.ts` shows it as a warning and this is where pig puts
    // the warnings that happen before the UI exists, beside the settings and credential ones.
    // Said at all because pig has just written in pi's directory, which is not something to do
    // quietly; one line rather than one per provider, because it is one thing that happened.
    fwrite(STDERR, Style::yellow(
        'Migrated credentials to auth.json: ' . implode(', ', $movedCredentials) . "\n",
    ));
}

Timings::mark('migrations');

// Not affected by `--no-save`, which is about not writing this conversation down. A stored
// sign-in is still the way in, and a token renewed during the run has to be kept or the next
// run starts by renewing a token that was already replaced.
$auth = Auth::discover(settings: $settings);

foreach ($auth->problems() as $problem) {
    fwrite(STDERR, Style::yellow("credentials: {$problem}\n"));
}

Timings::mark('credentials');

// Before the model is resolved, because `--model my-box/qwen3-coder` has to be able to find
// one of these. `--no-save` gets none of it: that flag means this run touches nothing of the
// person's, and a declared provider is one more thing read off their disk.
$custom = isset($options['no-save']) ? CustomModels::none() : CustomModels::discover();
$custom->install($auth);

foreach ($custom->problems as $problem) {
    // Named and carried on, like a settings file that is not JSON: the built-in models are
    // still there and the session still starts. A bad line loses only itself.
    fwrite(STDERR, Style::yellow("models.json: {$problem}\n"));
}

Timings::mark('customModels');

// After the declared providers, not before: a listing that cannot show the model somebody
// just added to `models.json` is a listing they will not trust about the rest either. It
// costs a settings read and a file read to get here, which nobody notices on a command that
// prints and exits.
if (isset($options['models'])) {
    echo ModelList::render($options['models']), "\n";

    exit(0);
}

$wanted = $options['model'] ?? (getenv('PIG_MODEL') ?: ($settings->defaultModel() ?? 'claude-sonnet-4-5'));
$choice = ModelResolver::parse($wanted);

if ($choice === null) {
    fwrite(STDERR, Style::red("No model matches '{$wanted}'. Try --models for the list.\n"));

    exit(1);
}

if ($choice->warning !== null) {
    fwrite(STDERR, Style::yellow($choice->warning . "\n"));
}

$model = $choice->model;

// A key typed on the command line is for this run only and is never written to `auth.json`.
// It goes in here, after the model is resolved, because the provider it belongs to is that
// model's — upstream refuses the flag unless a model was named explicitly; pig always has
// one, so there is nothing to refuse. An empty value is refused rather than stored: an empty
// runtime key would beat the environment and then fail as a missing key, which is the least
// informative way this could go wrong.
if (isset($options['api-key'])) {
    if ($options['api-key'] === '') {
        fwrite(STDERR, Style::red("--api-key needs a key after it.\n"));

        exit(1);
    }

    $auth->setRuntimeApiKey($model->provider, $options['api-key']);
}

$theme = $options['theme'] ?? (getenv('PIG_THEME') ?: ($settings->theme() ?? 'dark'));

// `--thinking` is the explicit one, so it wins over a `:level` suffix on the model, which
// in turn wins over the level chosen last time.
$level = isset($options['thinking'])
    ? ThinkingLevel::tryFrom($options['thinking']) ?? ThinkingLevel::Off
    : ($choice->thinking === ThinkingLevel::Off
        ? ($settings->defaultThinkingLevel() ?? ThinkingLevel::Off)
        : $choice->thinking);

if (!$model->reasoning) {
    $level = ThinkingLevel::Off;
}

if (!in_array($theme, Palette::names(), true)) {
    fwrite(STDERR, Style::red("No theme called '{$theme}'. There is " . implode(' and ', Palette::names()) . ".\n"));

    exit(1);
}

// Loaded here rather than left to the prompt builder, so the banner and the system
// prompt cannot disagree about what was picked up.
$contextFiles = ContextFiles::load($cwd);
Timings::mark('contextFiles');

[$skills, $skillWarnings] = $settings->skillsEnabled()
    ? Skills::load(
        $cwd,
        extraDirs: array_filter([$options['skills-dir'] ?? null, ...$settings->skillList('customDirectories')]),
        ignored: $settings->skillList('ignoredSkills'),
        only: $settings->skillList('includeSkills'),
    )
    : [[], []];
Timings::mark('skills');

$fileCommands = SlashCommands::load($cwd);
Timings::mark('slashCommands');

// On the shell rather than in the UI: a malformed skill is its author's problem, and the
// author is whoever just started pig — not the model, and not the transcript.
foreach ($skillWarnings as $warning) {
    fwrite(STDERR, Style::yellow("skill {$warning->path}: {$warning->message}\n"));
}

// Resolved before the UI starts, so a bad --resume is a line on the shell rather than
// an error inside a screen that has just been taken over.
//
// Before the agent as well as before the UI, because the hooks are handed the session
// file and the agent is handed the hooks.
$store = null;
$resumed = null;

if (!isset($options['no-save'])) {
    $wanted = $options['resume'] ?? null;

    // `--resume` with nothing after it means "show me the list": a session file is named
    // after six random bytes under a flattened project path, so a flag that demands the path
    // is a flag nobody can use from memory. Only with a terminal to draw it on — in
    // `--mode text|json|rpc` there is nobody to ask, so it stays the error it was.
    if ($wanted === '' && $interactive) {
        $sessions = SessionManager::listFor($cwd);

        if ($sessions === []) {
            fwrite(STDERR, Style::yellow("No earlier sessions in {$cwd}. Starting a new one.\n"));
        }

        // Escape answers null, which falls through to a new session below — someone who
        // opened the list and changed their mind still wanted pig, and refusing to start
        // would only make them type the command again.
        $wanted = SessionPicker::ask($sessions, Palette::named($theme));
    }

    if ($wanted === '') {
        fwrite(STDERR, Style::red("--resume needs the path to a session file.\n"));

        exit(1);
    }

    if ($wanted === null && isset($options['continue'])) {
        $latest = SessionManager::latestFor($cwd);

        if ($latest === null) {
            fwrite(STDERR, Style::red("No earlier session in {$cwd}.\n"));

            exit(1);
        }

        $wanted = $latest->path;
    }

    try {
        $store = $wanted === null ? SessionManager::create($cwd) : SessionManager::open($wanted);
    } catch (Throwable $error) {
        fwrite(STDERR, Style::red($error->getMessage() . "\n"));

        exit(1);
    }

    $resumed = $wanted === null ? null : $store;
}

Timings::mark('session');

// A hook is a PHP file that runs in this process, so a broken one is reported here, on
// the shell, next to the malformed skills — and for the same reason: whoever wrote it is
// whoever just started pig.
[$loadedHooks, $hookProblems] = isset($options['no-hooks'])
    ? [[], []]
    : HookLoader::load($cwd, $settings->hooks());

foreach ($hookProblems as $problem) {
    fwrite(STDERR, Style::yellow("hook {$problem->toText()}\n"));
}

$hooks = new HookRunner($loadedHooks, $cwd, $store);
Timings::mark('hooks');

// The same story, one folder over. The built-in names are handed in so a tool that would
// shadow `bash` is named rather than quietly replacing it.
$builtIn = isset($options['read-only']) ? ToolSet::READ_ONLY : ToolSet::ALL;

// Held onto rather than left to the loader: it is what the mode later hands the UI to,
// and it is the object every tool factory closed over.
$toolApi = new CustomToolApi($cwd);

[$loadedTools, $toolProblems] = isset($options['no-tools'])
    ? [[], []]
    : CustomToolLoader::load($cwd, $builtIn, $settings->customTools(), api: $toolApi);

foreach ($toolProblems as $problem) {
    fwrite(STDERR, Style::yellow("tool {$problem->toText()}\n"));
}

Timings::mark('customTools');

$customTools = new CustomToolSet($loadedTools, $toolApi);

try {
    $agent = CodingAgent::create(
        $model,
        $cwd,
        $builtIn,
        // Asked per turn rather than resolved once, because an OAuth token expires
        // mid-conversation and `Auth` renews it on the way past.
        getApiKey: $auth->apiKey(...),
        contextFiles: $contextFiles,
        thinking: $level,
        skills: $skills,
        hooks: $hooks,
        customTools: $customTools,
    );
} catch (Throwable $error) {
    // Almost always a missing API key, which is worth saying plainly rather than as a
    // stack trace on a screen that was about to become a UI.
    fwrite(STDERR, Style::red($error->getMessage() . "\n"));

    exit(1);
}

Timings::mark('agent');

$session = new AgentSession($agent, $cwd, $store, $settings, $hooks);

// What the hooks and the custom tools are told about the session is wired by the mode,
// not here: the interactive one is what has a screen to draw a dialog on, and upstream
// says the same — each mode provides its own UI. A second mode wires its own.

if ($resumed !== null) {
    $session->restore($resumed->messages());

    // And what it was being talked on. `--model` beats the file: that is someone saying what
    // they want now, where the file says what was true last time. Everything else about the
    // order is unchanged — typed, then the environment, then this session, then the settings.
    $session->restoreSettings(modelWasAskedFor: isset($options['model']));
}

// Read here rather than in the parser: a missing file should be reported after the cheap
// mistakes and before the expensive setup, and it is the one positional argument that can
// fail.
try {
    $files = FileArguments::read($fileArgs, $cwd);
} catch (Throwable $error) {
    fwrite(STDERR, Style::red($error->getMessage() . "\n"));

    exit(1);
}

// The files go in front of the first message, which is the one place they can go: the model
// reading `why is this slow?` needs the code above it, not after it.
if (!$files->isEmpty()) {
    $messages = $messages === [] ? [$files->text] : [$files->before($messages[0]), ...array_slice($messages, 1)];
}

// Here rather than at the end: startup is over the moment a mode takes the screen, and a
// report printed when pig quits would be one somebody has to scroll back to find — after an
// hour of conversation, if they are still there at all.
Timings::mark('files');
Timings::report();

// Standard output belongs to the answer in every non-interactive mode, which is why every
// warning above went to standard error: something parsing JSON lines must not find a yellow
// sentence about a broken hook among them.
$exit = 0;

if ($mode === 'rpc') {
    $running = new RpcMode($session, $cwd, $hooks, $customTools, $settings);

    // One fiber around the whole program: the prompt suspends on a socket, the terminal
    // wakes on a keystroke, and both need the same loop underneath them.
    Async::run(static fn () => $running->run());
} elseif (!$interactive) {
    $printing = new PrintMode($session, $mode ?? 'text', $hooks, $customTools);
    $exit = (int) Async::run(static fn (): int => $printing->run($messages, $files->images));
} else {
    // What changed since this person last looked, shown once. Not on `-c` or `-r`: somebody
    // picking a conversation back up is in the middle of something, and upstream skips it for
    // the same reason. The version is written down *when it is shown*, so a run that showed
    // nothing does not mark the notes as seen.
    $changelog = null;

    if (!isset($options['continue']) && !isset($options['resume'])) {
        $seen = $settings->lastChangelogVersion();
        $entries = Changelog::parse();
        // No record at all means a first run, which gets the whole file rather than nothing —
        // upstream's shape, and the alternative is that the first upgrade after installing is
        // the first one anybody hears about.
        $unseen = $seen === null ? $entries : Changelog::newerThan($entries, $seen);

        if ($unseen !== []) {
            $changelog = Changelog::join($unseen);
            $settings->setLastChangelogVersion(VERSION);
        }
    }

    $running = new InteractiveMode(
        $session,
        Palette::named($theme),
        $cwd,
        VERSION,
        $theme,
        contextFiles: $contextFiles,
        skills: $skills,
        fileCommands: $fileCommands,
        settings: $settings,
        hooks: $hooks,
        customTools: $customTools,
        auth: $auth,
        initialMessages: $messages,
        initialImages: $files->images,
        changelog: $changelog,
    );

    Async::run(static fn () => $running->run());

    // The first thing a person sees after quitting is their own shell, so the screen is
    // handed back the way it was found.
    echo "\n";
}

exit($exit);

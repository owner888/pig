{
    "name": "pig/pig",
    "description": "pi, ported to PHP: agent core, unified LLM API, terminal UI, coding agent CLI",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": ">=8.3",
        "pig/agent-core": "@dev",
        "pig/ai": "@dev",
        "pig/async": "@dev",
        "pig/tui": "@dev"
    },
    "repositories": [
        {
            "type": "path",
            "url": "packages/*"
        }
    ],
    "require-dev": {
        "phpunit/phpunit": "^12"
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "autoload-dev": {
        "psr-4": {
            "Pig\\Test\\": "test/",
            "Pig\\Agent\\Test\\": "packages/agent-core/test/",
            "Pig\\Ai\\Test\\": "packages/ai/test/",
            "Pig\\Async\\Test\\": "packages/async/test/",
            "Pig\\Tui\\Test\\": "packages/tui/test/"
        }
    },
    "config": {
        "sort-packages": true
    },
    "scripts": {
        "test": "phpunit",
        "lint": "@php test/lint.php"
    }
}

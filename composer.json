{
    "name": "pigagent/pig",
    "description": "pi, ported to PHP: agent core, unified LLM API, terminal UI, coding agent CLI",
    "type": "library",
    "keywords": ["agent", "llm", "cli", "tui", "coding-agent", "anthropic", "openai", "gemini"],
    "license": "MIT",
    "authors": [
        {
            "name": "owner888",
            "homepage": "https://github.com/owner888"
        }
    ],
    "bin": [
        "bin/pig",
        "bin/pig-ai"
    ],
    "require": {
        "php": ">=8.3",
        "composer-runtime-api": "^2.0",
        "ext-json": "*",
        "ext-mbstring": "*",
        "ext-openssl": "*",
        "ext-pcntl": "*",
        "ext-pcre": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^12"
    },
    "autoload": {
        "psr-4": {
            "Pig\\Agent\\": "packages/agent-core/src/",
            "Pig\\Ai\\": "packages/ai/src/",
            "Pig\\Async\\": "packages/async/src/",
            "Pig\\CodingAgent\\": "packages/coding-agent/src/",
            "Pig\\Codemode\\": "packages/codemode/src/",
            "Pig\\Mcp\\": "packages/mcp/src/",
            "Pig\\Tui\\": "packages/tui/src/"
        },
        "files": [
            "packages/coding-agent/src/Logger.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Pig\\Agent\\Test\\": "packages/agent-core/test/",
            "Pig\\Ai\\Test\\": "packages/ai/test/",
            "Pig\\Async\\Test\\": "packages/async/test/",
            "Pig\\CodingAgent\\Test\\": "packages/coding-agent/test/",
            "Pig\\Codemode\\Test\\": "packages/codemode/test/",
            "Pig\\Mcp\\Test\\": "packages/mcp/test/",
            "Pig\\Test\\": "test/",
            "Pig\\Tui\\Test\\": "packages/tui/test/"
        }
    },
    "config": {
        "sort-packages": true
    },
    "scripts": {
        "test": "phpunit",
        "lint": "@php test/lint.php"
    }
}

<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="test/bootstrap.php"
         colors="true"
         failOnWarning="true"
         failOnNotice="true"
         failOnDeprecation="true"
         beStrictAboutOutputDuringTests="true"
         cacheDirectory=".phpunit.cache"
         defaultTestSuite="pig">
    <testsuites>
        <testsuite name="pig">
            <directory>packages/async/test</directory>
            <directory>packages/ai/test</directory>
            <directory>packages/agent-core/test</directory>
            <directory>packages/tui/test</directory>
            <directory>packages/coding-agent/test</directory>
            <directory>packages/mcp/test</directory>
            <directory>packages/codemode/test</directory>
            <!-- Needs a MySQL server: set PIG_TEST_MYSQL_DSN and run the testsuite named mysql. -->
            <exclude>packages/coding-agent/test/Session/MysqlSessionStoreTest.php</exclude>
        </testsuite>
        <testsuite name="mysql">
            <file>packages/coding-agent/test/Session/MysqlSessionStoreTest.php</file>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>packages/async/src</directory>
            <directory>packages/ai/src</directory>
            <directory>packages/agent-core/src</directory>
            <directory>packages/tui/src</directory>
            <directory>packages/codemode/src</directory>
            <directory>packages/coding-agent/src</directory>
            <directory>packages/mcp/src</directory>
        </include>
    </source>
    <php>
        <ini name="memory_limit" value="1G"/>
        <env name="PIG_TESTING" value="1"/>
    </php>
</phpunit>

# Dependencies — composer.lock IS tracked (this root is type=project)
/vendor/
/packages/*/vendor/

# PHPUnit — phpunit.xml.dist is the tracked template, phpunit.xml the local override
/phpunit.xml
/.phpunit.cache
/packages/evals/.eval/
/.phpunit.result.cache
/coverage/
/clover.xml

# Eval baselines — `php scripts/eval.php --json > baseline.json`
/baseline.json

# Static analysis caches
/.php-cs-fixer.cache
/.phpstan.cache
/.rector.cache

# Local environment
.env
.env.local

# macOS
.DS_Store
._*
.AppleDouble
.LSOverride
.Spotlight-V100
.Trashes

